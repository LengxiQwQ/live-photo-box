<!-- KeyPhotoPage.xaml — 实况照片主图更换页面：CommandBar + 左侧控制面板 + 右侧任务队列 + 底部状态栏 -->
<Page
    x:Class="LivePhotoBox.Views.KeyPhotoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LivePhotoBox.Models"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- 统一卡片样式：圆角 12px，细边框，主题色背景 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- 队列项缩略图背景（微妙的强调色底色） -->
        <Style x:Key="ThumbnailPlaceholderStyle" TargetType="Border">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <!-- ================================================================ -->
    <!-- 根布局：三行 — CommandBar / 主内容 / 状态栏                        -->
    <!-- ================================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Row 0：CommandBar 顶部工具栏                                    -->
        <!-- ============================================================ -->
        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Stretch"
            IsDynamicOverflowEnabled="False">

            <!-- 添加文件 -->
            <AppBarButton
                x:Uid="KeyPhotoPage_AddFile"
                Command="{x:Bind ViewModel.AddFileCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <!-- 添加文件夹 -->
            <AppBarButton
                x:Uid="KeyPhotoPage_AddFolder"
                Command="{x:Bind ViewModel.AddFolderCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE838;" FontSize="16"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator/>

            <!-- 开始转换 -->
            <AppBarButton
                x:Uid="KeyPhotoPage_StartConvert"
                Command="{x:Bind ViewModel.StartConvertCommand}"
                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <!-- 暂停 -->
            <AppBarButton
                x:Uid="KeyPhotoPage_Pause"
                Command="{x:Bind ViewModel.PauseCommand}"
                IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE769;" FontSize="16"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <!-- 停止 -->
            <AppBarButton
                x:Uid="KeyPhotoPage_Stop"
                Command="{x:Bind ViewModel.StopCommand}"
                IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator/>

            <!-- 清空队列 -->
            <AppBarButton
                x:Uid="KeyPhotoPage_ClearQueue"
                Command="{x:Bind ViewModel.ClearQueueCommand}"
                IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- ============================================================ -->
        <!-- Row 1：主内容区 — 左侧控制面板 + 右侧任务队列                     -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Padding="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ························································ -->
            <!-- 左侧面板：ScrollViewer → 四个卡片                           -->
            <!-- ························································ -->
            <ScrollViewer
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Padding="0,0,0,16">

                    <!-- ─── Card 1：输入目录 ─── -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <!-- 标题行 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE8B7;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Uid="KeyPhotoPage_InputDirTitle"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 路径文本框 -->
                            <TextBox
                                x:Uid="KeyPhotoPage_InputDirBox"
                                Text="{x:Bind ViewModel.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="False"
                                VerticalAlignment="Center"
                                FontSize="13"/>

                            <!-- 浏览 / 打开 按钮 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="KeyPhotoPage_BrowseInputBtn"
                                    Click="BrowseInput_Click"
                                    MinWidth="80"
                                    Height="32"
                                    FontSize="13"/>
                                <Button
                                    x:Uid="KeyPhotoPage_OpenInputBtn"
                                    Command="{x:Bind ViewModel.OpenInputDirectoryCommand}"
                                    MinWidth="80"
                                    Height="32"
                                    FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── Card 2：输出目录 ─── -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <!-- 标题行 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE8B7;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Uid="KeyPhotoPage_OutputDirTitle"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 路径文本框 -->
                            <TextBox
                                x:Uid="KeyPhotoPage_OutputDirBox"
                                Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="False"
                                VerticalAlignment="Center"
                                FontSize="13"/>

                            <!-- 浏览 / 打开 按钮 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="KeyPhotoPage_BrowseOutputBtn"
                                    Click="BrowseOutput_Click"
                                    MinWidth="80"
                                    Height="32"
                                    FontSize="13"/>
                                <Button
                                    x:Uid="KeyPhotoPage_OpenOutputBtn"
                                    Command="{x:Bind ViewModel.OpenOutputDirectoryCommand}"
                                    MinWidth="80"
                                    Height="32"
                                    FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── Card 3：转换设置 ─── -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <!-- 标题行 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE115;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Uid="KeyPhotoPage_SettingsTitle"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 设置项列表 -->
                            <StackPanel Spacing="10">

                                <!-- 转换协议 -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="KeyPhotoPage_ProtocolLabel"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox
                                        Grid.Column="1"
                                        SelectedIndex="{x:Bind ViewModel.SelectedProtocolIndex, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        FontSize="13">
                                        <ComboBoxItem x:Uid="KeyPhotoPage_Protocol_V1"/>
                                        <ComboBoxItem x:Uid="KeyPhotoPage_Protocol_V2"/>
                                        <ComboBoxItem x:Uid="KeyPhotoPage_Protocol_Oppo"/>
                                    </ComboBox>
                                </Grid>

                                <!-- 输出格式 -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="KeyPhotoPage_FormatLabel"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox
                                        Grid.Column="1"
                                        SelectedIndex="{x:Bind ViewModel.SelectedOutputFormatIndex, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        FontSize="13">
                                        <ComboBoxItem x:Uid="KeyPhotoPage_Format_HEIC"/>
                                        <ComboBoxItem x:Uid="KeyPhotoPage_Format_JPEG"/>
                                    </ComboBox>
                                </Grid>

                                <!-- 命名规则 -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="KeyPhotoPage_NamingLabel"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox
                                        Grid.Column="1"
                                        SelectedIndex="{x:Bind ViewModel.SelectedNamingRuleIndex, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        FontSize="13">
                                        <ComboBoxItem x:Uid="KeyPhotoPage_Naming_Original"/>
                                        <ComboBoxItem x:Uid="KeyPhotoPage_Naming_Suffix"/>
                                    </ComboBox>
                                </Grid>

                                <!-- 分隔线 -->
                                <Border
                                    Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,4"/>

                                <!-- 保留原文件 -->
                                <ToggleSwitch
                                    x:Uid="KeyPhotoPage_KeepOriginal"
                                    IsOn="{x:Bind ViewModel.KeepOriginalFile, Mode=TwoWay}"
                                    FontSize="13"/>

                                <!-- 自动覆盖 -->
                                <ToggleSwitch
                                    x:Uid="KeyPhotoPage_AutoOverwrite"
                                    IsOn="{x:Bind ViewModel.AutoOverwrite, Mode=TwoWay}"
                                    FontSize="13"/>

                                <!-- 转换完成后打开目录 -->
                                <ToggleSwitch
                                    x:Uid="KeyPhotoPage_OpenOnComplete"
                                    IsOn="{x:Bind ViewModel.OpenDirectoryOnComplete, Mode=TwoWay}"
                                    FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── Card 4：统计信息 ─── -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <!-- 标题行 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE9D2;"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Uid="KeyPhotoPage_StatsTitle"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 统计数字：两列 Grid，标签左对齐 / 数字右对齐 -->
                            <Grid RowSpacing="8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 总文件 -->
                                <TextBlock x:Uid="KeyPhotoPage_TotalFiles"
                                           Grid.Row="0" Grid.Column="0"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{x:Bind ViewModel.TotalFiles, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                                <!-- 等待 -->
                                <TextBlock x:Uid="KeyPhotoPage_Waiting"
                                           Grid.Row="1" Grid.Column="0"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{x:Bind ViewModel.WaitingCount, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                                <!-- 处理中 -->
                                <TextBlock x:Uid="KeyPhotoPage_Processing"
                                           Grid.Row="2" Grid.Column="0"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{x:Bind ViewModel.ProcessingCount, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                                <!-- 成功 -->
                                <TextBlock x:Uid="KeyPhotoPage_Success"
                                           Grid.Row="3" Grid.Column="0"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{x:Bind ViewModel.SuccessCount, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#10B981"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                                <!-- 失败 -->
                                <TextBlock x:Uid="KeyPhotoPage_Failed"
                                           Grid.Row="4" Grid.Column="0"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{x:Bind ViewModel.FailedCount, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#EF4444"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 左右面板间距（16px 由 ColumnDefinition 提供） -->

            <!-- ························································ -->
            <!-- 右侧面板：任务队列（主要区域，自适应宽度）                       -->
            <!-- ························································ -->
            <Border
                Grid.Column="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── 队列标题行 ── -->
                    <Grid
                        Grid.Row="0"
                        Padding="16,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 标题 -->
                        <TextBlock
                            x:Uid="KeyPhotoPage_QueueTitle"
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            FontSize="16"
                            VerticalAlignment="Center"/>

                        <!-- 搜索框（居中） -->
                        <AutoSuggestBox
                            x:Uid="KeyPhotoPage_SearchBox"
                            Grid.Column="1"
                            Width="240"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            QueryIcon="Find"/>

                        <!-- 排序 / 筛选 按钮 -->
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Uid="KeyPhotoPage_SortBtn"
                                Width="32" Height="32" Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTipService.ToolTip="Sort">
                                <FontIcon
                                    Glyph="&#xE8CB;"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button
                                x:Uid="KeyPhotoPage_FilterBtn"
                                Width="32" Height="32" Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTipService.ToolTip="Filter">
                                <FontIcon
                                    Glyph="&#xE16F;"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 分隔线 -->
                    <Border
                        Grid.Row="0"
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        VerticalAlignment="Bottom"
                        Margin="12,0"/>

                    <!-- ── 任务列表 ── -->
                    <ListView
                        x:Name="KeyPhotoTaskListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Tasks}"
                        SelectionMode="None"
                        ShowsScrollingPlaceholders="False"
                        Margin="8,8,8,0"
                        ContainerContentChanging="KeyPhotoTaskListView_ContainerContentChanging">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel
                                    AreStickyGroupHeadersEnabled="False"
                                    CacheLength="4"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyPhotoTask">
                                <Border
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="76"
                                    Padding="12,0">

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 缩略图 -->
                                        <Border
                                            Grid.Column="0"
                                            Style="{StaticResource ThumbnailPlaceholderStyle}">
                                            <Grid>
                                                <!-- 缩略图加载前显示照片占位图标 -->
                                                <FontIcon
                                                    Glyph="&#xE722;"
                                                    FontSize="24"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}, FallbackValue=Visible}"/>
                                                <!-- 实际缩略图 -->
                                                <Image
                                                    Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                    Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <!-- 文件信息 + 状态/进度 -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 文件名 -->
                                            <TextBlock
                                                Grid.Row="0" Grid.Column="0"
                                                Text="{x:Bind FileName, Mode=OneWay}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center"/>

                                            <!-- 文件路径（第二行省略显示） -->
                                            <TextBlock
                                                Grid.Row="1" Grid.Column="0"
                                                Text="{x:Bind FilePath, Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center"
                                                MaxLines="1"
                                                Margin="0,2,0,0"/>

                                            <!-- 状态文本 + 进度条 -->
                                            <StackPanel
                                                Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4"
                                                Margin="16,0,0,0"
                                                MinWidth="140">
                                                <TextBlock
                                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToColorConverter}}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"/>
                                                <ProgressBar
                                                    Value="{x:Bind Progress, Mode=OneWay}"
                                                    Maximum="100"
                                                    Height="4"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Stretch"
                                                    Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToColorConverter}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 文件大小 + 耗时 -->
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="2"
                                            MinWidth="60">
                                            <TextBlock
                                                Text="{x:Bind FileSize, Mode=OneWay}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"/>
                                            <TextBlock
                                                Text="{x:Bind ElapsedTime, Mode=OneWay}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Visibility="{x:Bind ElapsedTime, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}, FallbackValue=Collapsed}"/>
                                        </StackPanel>

                                        <!-- 更多按钮 -->
                                        <Button
                                            Grid.Column="3"
                                            Width="32" Height="32" Padding="0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="More">
                                            <FontIcon
                                                Glyph="&#xE712;"
                                                FontSize="16"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- ── 空队列占位提示 ── -->
                    <StackPanel
                        Grid.Row="1"
                        Visibility="{x:Bind ViewModel.EmptyQueueVisibility, Mode=OneWay}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="16">
                        <FontIcon
                            Glyph="&#xEB9F;"
                            FontSize="64"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            Opacity="0.5"/>
                        <TextBlock
                            x:Uid="KeyPhotoPage_EmptyTitle"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            HorizontalAlignment="Center"/>
                        <TextBlock
                            x:Uid="KeyPhotoPage_EmptyDesc"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            MaxWidth="360"
                            TextAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- Row 2：底部状态栏（高度 40px）                                  -->
        <!-- ============================================================ -->
        <Border
            Grid.Row="2"
            Height="40"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,0">

            <Grid VerticalAlignment="Center" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：状态文本 -->
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center"
                    Opacity="0.9"/>

                <!-- 中间：整体进度条 -->
                <ProgressBar
                    Grid.Column="1"
                    Value="{x:Bind ViewModel.OverallProgressBarValue, Mode=OneWay}"
                    Maximum="100"
                    Height="4"
                    CornerRadius="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                <!-- 右侧：成功 / 失败 / 剩余时间 -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="16"
                    VerticalAlignment="Center">

                    <!-- 成功计数 -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE73E;"
                            FontSize="11"
                            Foreground="#10B981"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.SuccessCount, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 失败计数 -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE783;"
                            FontSize="11"
                            Foreground="#EF4444"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.FailedCount, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 剩余时间 -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE823;"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="{x:Bind ViewModel.RemainingTime, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
