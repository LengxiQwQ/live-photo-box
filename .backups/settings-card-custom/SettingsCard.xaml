<UserControl
    x:Class="LivePhotoBox.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="4"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="20,12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
            <ContentPresenter x:Name="IconPresenter" Grid.Column="0"
                              VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <ContentPresenter x:Name="HeaderPresenter"/>
                <ContentPresenter x:Name="DescriptionPresenter"/>
            </StackPanel>
            <ContentPresenter x:Name="ActionContentPresenter" Grid.Column="2"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>
