# Disabled by maintainer decision on 2026-08-31.
#
# This preserves the former Dependabot version-update policy without allowing
# GitHub to create branches or pull requests automatically. To re-enable it,
# rename this file to dependabot.yml only after explicit maintainer approval.
version: 2
updates:
  - package-ecosystem: nuget
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    groups:
      dotnet-sdk-packages:
        patterns:
          - "Microsoft.*"
          - "System.*"

  - package-ecosystem: github-actions
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
