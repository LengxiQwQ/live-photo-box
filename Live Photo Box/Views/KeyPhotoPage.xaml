<!--
    KeyPhotoPage.xaml — 第六轮精修

    照片：📷大小/分辨率/日期 + 🎬视频/编码 + 协议 · 按钮在缩略图下
    EXIF 左上对齐自动换行 · 地图 50/50
-->
<Page
    x:Class="LivePhotoBox.Views.KeyPhotoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LivePhotoBox.Models"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="InfoCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="LeftFileListSurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="PreviewToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Row 0：CommandBar + 目录                                       -->
        <!-- ============================================================ -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right"
                    HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="False">
            <AppBarButton x:Uid="KeyPhotoPage_Restore" Command="{x:Bind ViewModel.RestoreCommand}"
                          IsEnabled="{x:Bind ViewModel.IsModified, Mode=OneWay}" Label="恢复">
                <AppBarButton.Icon><FontIcon Glyph="&#xE777;" FontSize="14"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Uid="KeyPhotoPage_Save" Command="{x:Bind ViewModel.SaveCommand}"
                          IsEnabled="{x:Bind ViewModel.IsModified, Mode=OneWay}" Label="保存">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" FontSize="14"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="KeyPhotoPage_SaveAs" Command="{x:Bind ViewModel.SaveAsCommand}" Label="另存为">
                <AppBarButton.Icon><FontIcon Glyph="&#xE792;" FontSize="14"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="KeyPhotoPage_ViewFullProps"
                          Command="{x:Bind ViewModel.ViewFullPropertiesCommand}" Label="完整属性">
                <AppBarButton.Icon><FontIcon Glyph="&#xE9D2;" FontSize="14"/></AppBarButton.Icon>
            </AppBarButton>

            <CommandBar.Content>
                <Grid ColumnSpacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Uid="KeyPhotoPage_CurrentDirBox"
                             Text="{x:Bind ViewModel.CurrentDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="当前目录..."
                             FontSize="12" Height="28" Padding="10,1,10,1"
                             VerticalAlignment="Center" IsReadOnly="False"/>
                    <Button Grid.Column="1" x:Uid="KeyPhotoPage_BrowseFolderBtn"
                            Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                            Click="BrowseFolder_Click" ToolTipService.ToolTip="浏览文件夹">
                        <FontIcon Glyph="&#xE838;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>
            </CommandBar.Content>
        </CommandBar>

        <!-- ============================================================ -->
        <!-- Row 1：主内容                                                   -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Padding="8,4,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ························································ -->
            <!-- 左侧面板                                                     -->
            <!-- ························································ -->
            <Border Grid.Column="0" Style="{StaticResource LeftFileListSurface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Padding="10,8,10,6" Spacing="4">
                        <AutoSuggestBox x:Uid="KeyPhotoPage_SearchBox"
                                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="搜索文件..."
                                        FontSize="12" Height="28"
                                        VerticalAlignment="Center" QueryIcon="Find"/>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                                      FontSize="12" Height="28" Padding="10,1,6,1"
                                      VerticalAlignment="Center">
                                <ComboBoxItem x:Uid="KeyPhotoPage_Sort_Name" Content="名称"/>
                                <ComboBoxItem x:Uid="KeyPhotoPage_Sort_Date" Content="日期"/>
                                <ComboBoxItem x:Uid="KeyPhotoPage_Sort_Size" Content="大小"/>
                            </ComboBox>
                            <ToggleButton Grid.Column="1" x:Uid="KeyPhotoPage_ViewModeToggle"
                                          Width="26" Height="26" Padding="0" VerticalAlignment="Center"
                                          Background="Transparent" BorderBrush="Transparent"
                                          ToolTipService.ToolTip="筛选" IsChecked="True">
                                <FontIcon Glyph="&#xE16F;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </ToggleButton>
                            <Button Grid.Column="2" x:Uid="KeyPhotoPage_SortDirectionBtn"
                                    Width="26" Height="26" Padding="0" VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent"
                                    ToolTipService.ToolTip="排序方向">
                                <FontIcon Glyph="&#xE8CB;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Row="0" Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            VerticalAlignment="Bottom" Margin="8,0"/>
                    <ListView x:Name="FileItemListView" Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FileItems}"
                              SelectionMode="Single" ShowsScrollingPlaceholders="False"
                              Padding="0,0,14,0" Margin="3,5,3,0">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel AreStickyGroupHeadersEnabled="False" CacheLength="8"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyPhotoFileItem">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="7" Padding="9,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="5"
                                                Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE722;" FontSize="18"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind FileName}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1">
                                                <Run Text="{x:Bind Resolution}"/>
                                                <Run Text=" │ " Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                                                <Run Text="{x:Bind FileSize}"/>
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind DateTaken}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" MaxLines="1"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ························································ -->
            <!-- 右侧                                                       -->
            <!-- ························································ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 图片预览 ── -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}"
                        Padding="0" Margin="0,0,0,4">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"/>
                        <StackPanel Orientation="Horizontal" Spacing="2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5,5,5,0">
                            <Button x:Uid="KeyPhotoPage_ZoomOutBtn"
                                    Style="{StaticResource PreviewToolbarButtonStyle}" ToolTipService.ToolTip="缩小">
                                <FontIcon Glyph="&#xE949;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button x:Uid="KeyPhotoPage_ZoomResetBtn"
                                    Style="{StaticResource PreviewToolbarButtonStyle}" Width="34"
                                    ToolTipService.ToolTip="100%">
                                <TextBlock Text="100%" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                            <Button x:Uid="KeyPhotoPage_ZoomInBtn"
                                    Style="{StaticResource PreviewToolbarButtonStyle}" ToolTipService.ToolTip="放大">
                                <FontIcon Glyph="&#xE948;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Border Width="1" Height="14"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                    VerticalAlignment="Center" Margin="1,0"/>
                            <Button x:Uid="KeyPhotoPage_FitWindowBtn"
                                    Style="{StaticResource PreviewToolbarButtonStyle}" ToolTipService.ToolTip="适应窗口">
                                <FontIcon Glyph="&#xE740;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button x:Uid="KeyPhotoPage_OneToOneBtn"
                                    Style="{StaticResource PreviewToolbarButtonStyle}" ToolTipService.ToolTip="1:1">
                                <FontIcon Glyph="&#xE799;" FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── 时间轴 ── -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"
                        Padding="10,7,10,8" Margin="0,0,0,4">
                    <StackPanel Spacing="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8B2;" FontSize="13"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Uid="KeyPhotoPage_TimelineTitle"
                                           Text="Live Photo 时间轴" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.TimelineInfo, Mode=OneWay}"
                                       FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <ScrollViewer x:Name="TimelineScrollViewer"
                                      HorizontalScrollBarVisibility="Visible"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"
                                      Height="72"
                                      PointerWheelChanged="TimelineScrollViewer_PointerWheelChanged">
                            <ItemsControl x:Name="TimelineThumbnailsControl" Height="54">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="52" Height="52" CornerRadius="5"
                                                Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <FontIcon Glyph="&#xE722;" FontSize="20"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ── 统一信息面板 ── -->
                <Border Grid.Row="2" Style="{StaticResource InfoCardBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0：缩略图 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <Border Width="56" Height="56" CornerRadius="6"
                                    Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE722;" FontSize="22"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Col 1：照片 + Live Photo 信息 -->
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind ViewModel.PhotoFileName, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE722;" FontSize="11"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.PhotoInfoLine, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE714;" FontSize="11"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.VideoInfoLine, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.ProtocolLine, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}"/>
                        </StackPanel>

                        <!-- 竖线分割 -->
                        <Border Grid.Column="2" Width="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                VerticalAlignment="Stretch" Margin="0,2"/>

                        <!-- Col 3：EXIF + 地图（设备名独占全宽，参数+地图左右） -->
                        <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Top">

                            <!-- 设备名：独占一行全宽 -->
                            <TextBlock Text="{x:Bind ViewModel.ExifCamera, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap"/>

                            <!-- 参数 + 地图 左右结构 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Top">
                                    <TextBlock Text="{x:Bind ViewModel.ExifFocalLength, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ExifAperture, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ExifShutterSpeed, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.ExifIso, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}"/>
                                </StackPanel>

                                <!-- 地图：占满剩余宽度 -->
                                <Border Grid.Column="1" CornerRadius="6"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Uid="KeyPhotoPage_MapPlaceholder"
                                               Text="地图（后续实现）" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="4"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
