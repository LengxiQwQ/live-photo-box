<!--
    KeyPhotoPage.xaml — 第七轮精修

    照片：📷大小/分辨率/日期 + 🎬视频/编码 + 协议 · 按钮在缩略图下
    EXIF 左上对齐自动换行 · 地图 50/50

    时间轴：ItemsRepeater + ScrollViewer（替代 ListView）
    · 中心锚点竖线固定 · 吸附动画可开关 · 惯性可独立禁用
    · 帧卡片选中态通过 x:Bind → FrameBorderBrush/FrameBackground 驱动
-->
<Page
    x:Class="LivePhotoBox.Views.KeyPhotoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LivePhotoBox.Models"
    xmlns:converters="using:LivePhotoBox.Converters"
    xmlns:controls="using:LivePhotoBox.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  自定义 ScrollBar 样式：永驻粗态（禁用 ConsciousStates 收缩动画）  -->
        <!--  根因：WinUI 3 ScrollBar 的 C++ 层根据鼠标位置切换                -->
        <!--        ConsciousStates (Expanded ↔ Collapsed)。托管代码无法          -->
        <!--        阻止此切换，只能通过替换模板消除视觉差异。                      -->
        <!--        此模板移除了 ConsciousStates 组，并把所有元素默认值             -->
        <!--        设成 ExpandedWithoutAnimation 等同态。                        -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="AlwaysThickScrollBarStyle" TargetType="ScrollBar"
               BasedOn="{StaticResource DefaultScrollBarStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root">
                            <Grid.Resources>
                                <!-- 子模板与默认 ScrollBar 一致，供内部引用 -->
                                <ControlTemplate x:Key="RepeatButtonTemplate" TargetType="RepeatButton">
                                    <Grid x:Name="Root" Background="Transparent" />
                                </ControlTemplate>
                                <ControlTemplate x:Key="HorizontalIncrementTemplate" TargetType="RepeatButton">
                                    <Grid x:Name="Root" Background="{ThemeResource ScrollBarButtonBackground}" BorderBrush="{ThemeResource ScrollBarButtonBorderBrush}" Padding="{ThemeResource ScrollBarHorizontalIncreaseMargin}">
                                        <FontIcon x:Name="Arrow" RenderTransformOrigin="0.5,0.5" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEDDA;" Foreground="{ThemeResource ScrollBarButtonArrowForeground}" FontSize="{StaticResource ScrollBarButtonArrowIconFontSize}" MirroredWhenRightToLeft="True">
                                            <FontIcon.RenderTransform><ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/></FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Grid>
                                </ControlTemplate>
                                <ControlTemplate x:Key="HorizontalDecrementTemplate" TargetType="RepeatButton">
                                    <Grid x:Name="Root" Background="{ThemeResource ScrollBarButtonBackground}" BorderBrush="{ThemeResource ScrollBarButtonBorderBrush}" Padding="{ThemeResource ScrollBarHorizontalDecreaseMargin}">
                                        <FontIcon x:Name="Arrow" RenderTransformOrigin="0.5,0.5" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEDD9;" Foreground="{ThemeResource ScrollBarButtonArrowForeground}" FontSize="{StaticResource ScrollBarButtonArrowIconFontSize}" MirroredWhenRightToLeft="True">
                                            <FontIcon.RenderTransform><ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/></FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Grid>
                                </ControlTemplate>
                                <ControlTemplate x:Key="VerticalIncrementTemplate" TargetType="RepeatButton">
                                    <Grid x:Name="Root" Background="{ThemeResource ScrollBarButtonBackground}" BorderBrush="{ThemeResource ScrollBarButtonBorderBrush}" Padding="{ThemeResource ScrollBarVerticalIncreaseMargin}">
                                        <FontIcon x:Name="Arrow" RenderTransformOrigin="0.5,0.5" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEDDC;" Foreground="{ThemeResource ScrollBarButtonArrowForeground}" FontSize="{StaticResource ScrollBarButtonArrowIconFontSize}">
                                            <FontIcon.RenderTransform><ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/></FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Grid>
                                </ControlTemplate>
                                <ControlTemplate x:Key="VerticalDecrementTemplate" TargetType="RepeatButton">
                                    <Grid x:Name="Root" Background="{ThemeResource ScrollBarButtonBackground}" BorderBrush="{ThemeResource ScrollBarButtonBorderBrush}" Padding="{ThemeResource ScrollBarVerticalDecreaseMargin}">
                                        <FontIcon x:Name="Arrow" RenderTransformOrigin="0.5,0.5" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEDDB;" Foreground="{ThemeResource ScrollBarButtonArrowForeground}" FontSize="{StaticResource ScrollBarButtonArrowIconFontSize}">
                                            <FontIcon.RenderTransform><ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/></FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Grid>
                                </ControlTemplate>

                                <!-- Thumb 模板：省略 VSM（默认态即展开态），必须保留 ThumbVisual 名称等 -->
                                <ControlTemplate x:Key="VerticalThumbTemplate" TargetType="Thumb">
                                    <Rectangle x:Name="ThumbVisual" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{ThemeResource ScrollBarThumbStrokeThickness}" RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}" RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
                                </ControlTemplate>
                                <ControlTemplate x:Key="HorizontalThumbTemplate" TargetType="Thumb">
                                    <Rectangle x:Name="ThumbVisual" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{ThemeResource ScrollBarThumbStrokeThickness}" RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}" RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
                                </ControlTemplate>
                            </Grid.Resources>

                            <VisualStateManager.VisualStateGroups>
                                <!-- CommonStates（仅 Disabled）—— 保留默认逻辑 -->
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ScrollBarBackgroundDisabled}" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource ScrollBarBorderBrushDisabled}" />
                                            <Setter Target="Root.Opacity" Value="0.5" />
                                            <Setter Target="HorizontalTrackRect.Stroke" Value="{ThemeResource ScrollBarTrackStrokeDisabled}" />
                                            <Setter Target="VerticalTrackRect.Stroke" Value="{ThemeResource ScrollBarTrackStrokeDisabled}" />
                                            <Setter Target="HorizontalTrackRect.Fill" Value="{ThemeResource ScrollBarTrackFillDisabled}" />
                                            <Setter Target="VerticalTrackRect.Fill" Value="{ThemeResource ScrollBarTrackFillDisabled}" />
                                            <Setter Target="HorizontalPanningThumb.Background" Value="{ThemeResource ScrollBarPanningThumbBackgroundDisabled}" />
                                            <Setter Target="VerticalPanningThumb.Background" Value="{ThemeResource ScrollBarPanningThumbBackgroundDisabled}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>

                                <!-- ScrollingIndicatorStates —— 保留，确保 MouseIndicator 下元素 hit-testable -->
                                <VisualStateGroup x:Name="ScrollingIndicatorStates">
                                    <VisualState x:Name="TouchIndicator">
                                        <VisualState.Setters>
                                            <Setter Target="HorizontalRoot.Visibility" Value="Collapsed" />
                                            <Setter Target="VerticalRoot.Visibility" Value="Collapsed" />
                                            <Setter Target="HorizontalPanningRoot.Opacity" Value="1" />
                                            <Setter Target="VerticalPanningRoot.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="MouseIndicator">
                                        <VisualState.Setters>
                                            <Setter Target="HorizontalPanningRoot.Visibility" Value="Collapsed" />
                                            <Setter Target="VerticalPanningRoot.Visibility" Value="Collapsed" />
                                            <Setter Target="HorizontalRoot.IsHitTestVisible" Value="True" />
                                            <Setter Target="VerticalRoot.IsHitTestVisible" Value="True" />
                                            <Setter Target="HorizontalThumb.Opacity" Value="1" />
                                            <Setter Target="VerticalThumb.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="NoIndicator">
                                        <VisualState.Setters>
                                            <Setter Target="HorizontalThumb.Background" Value="{ThemeResource ScrollBarPanningThumbBackground}" />
                                            <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarPanningThumbBackground}" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalSmallIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalLargeIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalLargeDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalSmallDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalTrackRect" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="HorizontalSmallIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="HorizontalLargeIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="HorizontalLargeDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="HorizontalThumb" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="HorizontalSmallDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="HorizontalTrackRect" Storyboard.TargetProperty="Opacity" To="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalRoot" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="{StaticResource ScrollBarOpacityChangeDuration}"><DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value></DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="VerticalRoot" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="{StaticResource ScrollBarOpacityChangeDuration}"><DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value></DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="HorizontalPanningRoot" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalPanningRoot" Storyboard.TargetProperty="Opacity" To="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalPanningRoot" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="{StaticResource ScrollBarContractDuration}"><DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value></DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="VerticalPanningRoot" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="{StaticResource ScrollBarContractDuration}"><DiscreteObjectKeyFrame.Value><Visibility>Collapsed</Visibility></DiscreteObjectKeyFrame.Value></DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>

                                <!-- ▸▸▸ ConsciousStates 已移除 —— 这是核心修改 ▸▸▸
                                     所有元素默认值直接设为展开态（Opacity=1, Thumb 宽度=ScrollBarSize, Offset=0）。
                                     ScrollBar C++ 层仍会调用 GoToState("Expanded"/"Collapsed")，
                                     但找不到状态组 → 无操作 → 滚动条始终维持展开外观。 -->
                            </VisualStateManager.VisualStateGroups>

                            <!-- ═══════════ 横向滚动条 ═══════════ -->
                            <Grid x:Name="HorizontalRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Opacity/尺寸全部改为展开态默认值 -->
                                <Rectangle x:Name="HorizontalTrackRect" RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter2x}}" RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter2x}}" Opacity="1" Grid.ColumnSpan="5" Margin="0" StrokeThickness="{ThemeResource ScrollBarTrackBorderThemeThickness}">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{ThemeResource SystemBaseMediumLowColor}" Opacity="0.10" />
                                    </Rectangle.Fill>
                                    <Rectangle.Stroke>
                                        <SolidColorBrush Color="{ThemeResource SystemBaseMediumLowColor}" Opacity="0.16" />
                                    </Rectangle.Stroke>
                                </Rectangle>
                                <RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0" Opacity="1" MinHeight="{StaticResource ScrollBarSize}" IsTabStop="False" Interval="50" Padding="{ThemeResource ScrollBarHorizontalDecreaseMargin}" Template="{StaticResource HorizontalDecrementTemplate}" Width="{StaticResource ScrollBarSize}" AllowFocusOnInteraction="False" VerticalAlignment="Center" />
                                <RepeatButton x:Name="HorizontalLargeDecrease" Opacity="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False" Interval="50" Template="{StaticResource RepeatButtonTemplate}" Width="0" AllowFocusOnInteraction="False" />
                                <Thumb x:Name="HorizontalThumb" Opacity="1" Grid.Column="2" Background="{ThemeResource ScrollBarPanningThumbBackground}" BorderBrush="{ThemeResource ScrollBarThumbBorderBrush}" Template="{StaticResource HorizontalThumbTemplate}" Height="{StaticResource ScrollBarSize}" MinWidth="{StaticResource ScrollBarHorizontalThumbMinWidth}" AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="0.5,1" CornerRadius="{TemplateBinding CornerRadius}">
                                    <Thumb.RenderTransform><TranslateTransform x:Name="HorizontalThumbTransform" Y="0" /></Thumb.RenderTransform>
                                </Thumb>
                                <RepeatButton x:Name="HorizontalLargeIncrease" Opacity="1" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False" Interval="50" AllowFocusOnInteraction="False" Template="{StaticResource RepeatButtonTemplate}" />
                                <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Opacity="1" MinHeight="{StaticResource ScrollBarSize}" IsTabStop="False" Interval="50" Padding="{ThemeResource ScrollBarHorizontalIncreaseMargin}" Template="{StaticResource HorizontalIncrementTemplate}" Width="{StaticResource ScrollBarSize}" AllowFocusOnInteraction="False" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 触控平移指示器（TouchIndicator 模式时才显示） -->
                            <Grid x:Name="HorizontalPanningRoot" MinWidth="24" Visibility="Collapsed" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="HorizontalPanningThumb" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{ThemeResource ScrollBarPanningThumbBackground}" BorderThickness="0" Height="2" MinWidth="32" Margin="0,2,0,2" />
                            </Grid>

                            <!-- ═══════════ 纵向滚动条 ═══════════ -->
                            <Grid x:Name="VerticalRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Opacity/尺寸全部改为展开态默认值 -->
                                <Rectangle x:Name="VerticalTrackRect" RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter2x}}" RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter2x}}" Opacity="1" Grid.RowSpan="5" Margin="0" StrokeThickness="{ThemeResource ScrollBarTrackBorderThemeThickness}">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{ThemeResource SystemBaseMediumLowColor}" Opacity="0.10" />
                                    </Rectangle.Fill>
                                    <Rectangle.Stroke>
                                        <SolidColorBrush Color="{ThemeResource SystemBaseMediumLowColor}" Opacity="0.16" />
                                    </Rectangle.Stroke>
                                </Rectangle>
                                <RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0" Opacity="1" Height="{StaticResource ScrollBarSize}" MinWidth="{StaticResource ScrollBarSize}" IsTabStop="False" Interval="50" Padding="{ThemeResource ScrollBarVerticalDecreaseMargin}" Template="{StaticResource VerticalDecrementTemplate}" HorizontalAlignment="Center" />
                                <RepeatButton x:Name="VerticalLargeDecrease" Opacity="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="0" IsTabStop="False" Interval="50" Grid.Row="1" AllowFocusOnInteraction="False" Template="{StaticResource RepeatButtonTemplate}" />
                                <!-- ▸▸▸ 核心：Thumb Width 设为 ScrollBarSize（12px），不再是 MinWidth（8px）▸▸▸ -->
                                <Thumb x:Name="VerticalThumb" Opacity="1" Grid.Row="2" Background="{ThemeResource ScrollBarPanningThumbBackground}" BorderBrush="{ThemeResource ScrollBarThumbBorderBrush}" Template="{StaticResource VerticalThumbTemplate}" Width="{StaticResource ScrollBarSize}" MinHeight="{StaticResource ScrollBarVerticalThumbMinHeight}" AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="1,0.5" CornerRadius="{TemplateBinding CornerRadius}">
                                    <!-- ▸▸▸ 核心：Transform X 设为 0，不再是 ScrollBarThumbOffset（2）▸▸▸ -->
                                    <Thumb.RenderTransform><TranslateTransform x:Name="VerticalThumbTransform" X="0" /></Thumb.RenderTransform>
                                </Thumb>
                                <RepeatButton x:Name="VerticalLargeIncrease" Opacity="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False" Interval="50" Grid.Row="3" AllowFocusOnInteraction="False" Template="{StaticResource RepeatButtonTemplate}" />
                                <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Opacity="1" Height="{StaticResource ScrollBarSize}" MinWidth="{StaticResource ScrollBarSize}" IsTabStop="False" Interval="50" Padding="{ThemeResource ScrollBarVerticalIncreaseMargin}" Template="{StaticResource VerticalIncrementTemplate}" HorizontalAlignment="Center" />
                            </Grid>

                            <!-- 触控平移指示器 -->
                            <Grid x:Name="VerticalPanningRoot" MinHeight="24" Visibility="Collapsed" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="VerticalPanningThumb" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{ThemeResource ScrollBarPanningThumbBackground}" BorderThickness="0" Width="2" MinHeight="32" Margin="2,0,2,0" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 隐式 ScrollBar 样式：页面内所有 ScrollBar 默认保持粗态 -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource AlwaysThickScrollBarStyle}" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="InfoCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="LeftFileListSurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="InfoRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="-4,-2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Row 0：标题 + CommandBar（同层 Grid，标题真正垂直居中）             -->
        <!-- ============================================================ -->
        <Grid x:Name="TopBarGrid" Grid.Row="0">
            <CommandBar DefaultLabelPosition="Right"
                        HorizontalAlignment="Stretch" IsDynamicOverflowEnabled="False"
                        Background="Transparent">
                <AppBarButton x:Uid="KeyPhotoPage_Restore" Command="{x:Bind ViewModel.RestoreCommand}"
                              IsEnabled="{x:Bind ViewModel.IsModified, Mode=OneWay}" Label="恢复">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE777;" FontSize="14"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Uid="KeyPhotoPage_Save" Command="{x:Bind ViewModel.SaveCommand}"
                              IsEnabled="{x:Bind ViewModel.IsModified, Mode=OneWay}" Label="保存">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" FontSize="14"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="KeyPhotoPage_SaveAs" Command="{x:Bind ViewModel.SaveAsCommand}" Label="另存为">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE792;" FontSize="14"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="KeyPhotoPage_ViewFullProps"
                              Command="{x:Bind ViewModel.ViewFullPropertiesCommand}" Label="完整属性">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE9D2;" FontSize="14"/></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <!-- 标题独立于 CommandBar，与按钮共享同一行高度，垂直真正居中 -->
            <TextBlock x:Uid="KeyPhotoPage_PageTitle"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Margin="18,0,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- ============================================================ -->
        <!-- Row 1：主内容                                                   -->
        <!-- ============================================================ -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Padding="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="320"/>
                <ColumnDefinition x:Name="PanelSpacerColumn" Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ························································ -->
            <!-- 左侧面板                                                     -->
            <!-- ························································ -->
            <Border x:Name="LeftPanelBorder" Grid.Column="0" Style="{StaticResource LeftFileListSurface}"
                    AllowDrop="True">
                <!-- 外层 Grid：让原始内容 + DragOverlay 叠加（Border 只能有一个子元素） -->
                <Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 标题行 -->
                            <RowDefinition Height="Auto"/>   <!-- 控件区 -->
                            <RowDefinition Height="Auto"/>   <!-- 文件统计 -->
                            <RowDefinition Height="*"/>      <!-- ListView -->
                        </Grid.RowDefinitions>

                    <!-- ── 标题行：资源浏览 + 折叠按钮 ── -->
                    <Grid Grid.Row="0" Margin="10,10,10,4">
                        <TextBlock x:Name="PanelTitleText" x:Uid="KeyPhotoPage_PanelTitle"
                                   Text="资源浏览"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Button x:Name="CollapsePanelButton"
                                Width="28" Height="28" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Click="CollapsePanelButton_Click"
                                Visibility="{x:Bind ViewModel.HasAnyFiles, Mode=OneWay}"
                                x:Uid="KeyPhotoPage_CollapsePanel"
                                ToolTipService.ToolTip="折叠面板">
                            <FontIcon x:Name="CollapseButtonIcon" Glyph="&#xE76B;"
                                      FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="PanelControlsArea" Grid.Row="1" Margin="10,8,10,8" Spacing="8">
                        <!-- ── 文件夹路径 ── -->
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Uid="KeyPhotoPage_CurrentDirBox"
                                     x:Name="CurrentDirTextBox"
                                     Text="{x:Bind ViewModel.CurrentDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="当前目录..."
                                     FontSize="12" MinHeight="28" Height="28" Padding="10,5,10,5"
                                     VerticalContentAlignment="Center" VerticalAlignment="Center"
                                     LostFocus="CurrentDirTextBox_LostFocus">
                                <TextBox.Resources>
                                    <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Grid.Column="1" x:Uid="KeyPhotoPage_BrowseFolderBtn"
                                    Width="28" Height="28" Padding="0" CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Click="BrowseFolder_Click"
                                    PointerPressed="BrowseFolder_PointerPressed"
                                    ToolTipService.ToolTip="浏览文件夹">
                                <FontIcon Glyph="&#xE838;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button Grid.Column="2" x:Uid="KeyPhotoPage_RefreshDirBtn"
                                    Width="28" Height="28" Padding="0" CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Click="RefreshDir_Click"
                                    ToolTipService.ToolTip="刷新目录">
                                <FontIcon Glyph="&#xE72C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>
                        <!-- ── 搜索 + 排序 ── -->
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox Grid.Column="0" x:Uid="KeyPhotoPage_SearchBox"
                                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="搜索文件..."
                                            FontSize="12" Height="28" MinHeight="28" Padding="10,0,30,0"
                                            VerticalContentAlignment="Center" VerticalAlignment="Center">
                                <AutoSuggestBox.Resources>
                                    <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
                                </AutoSuggestBox.Resources>
                            </AutoSuggestBox>
                            <ComboBox Grid.Column="1" x:Name="SortComboBox"
                                      SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                                      FontSize="12" MinHeight="28" Height="28" Padding="10,3,6,3"
                                      VerticalAlignment="Center">
                                <ComboBoxItem x:Uid="KeyPhotoPage_Sort_Name" Content="名称"/>
                                <ComboBoxItem x:Uid="KeyPhotoPage_Sort_Date" Content="日期"/>
                                <ComboBoxItem x:Uid="KeyPhotoPage_Sort_Size" Content="大小"/>
                            </ComboBox>
                            <Button Grid.Column="2" x:Uid="KeyPhotoPage_SortDirectionBtn"
                                    Width="28" Height="28" Padding="0" CornerRadius="5"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    ToolTipService.ToolTip="排序方向">
                                <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <!-- ── 文件统计 + 照片类型过滤（左两行文字，右 ComboBox）── -->
                    <Grid Grid.Row="2" Margin="10,8,10,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="FileCountText" Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <!-- 实况照片行 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Uid="KeyPhoto_LivePhotoLabel"
                                           Text="实况照片" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Column="1" Text=":" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Column="3" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="{x:Bind ViewModel.LivePhotoCount, Mode=OneWay}"/>
                            </Grid>
                            <!-- 其他文件行 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Uid="KeyPhoto_OtherFileLabel"
                                           Text="其他照片" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Column="1" Text=":" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Column="3" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="{x:Bind ViewModel.OtherCount, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                        <!-- 扫描加载动画 -->
                        <ProgressRing Grid.Column="1" Width="12" Height="12"
                                      IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <ComboBox Grid.Column="2" x:Name="FilterComboBox"
                                  SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}"
                                  FontSize="12" MinHeight="28" Height="28" Padding="10,3,6,3"
                                  IsEditable="False" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="KeyPhoto_Filter_All">所有照片</ComboBoxItem>
                            <ComboBoxItem x:Uid="KeyPhoto_Filter_Live">仅实况照片</ComboBoxItem>
                            <ComboBoxItem x:Uid="KeyPhoto_Filter_Regular">仅普通照片</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <!-- ▸▸▸ ListView + 渐变遮罩（折叠时遮住文字，只露缩略图）▸▸▸ -->
                    <Grid Grid.Row="3">
                        <ListView x:Name="FileItemListView"
                                  ItemsSource="{x:Bind ViewModel.FileItems}"
                                  SelectionMode="Single" ShowsScrollingPlaceholders="False"
                                  Padding="0,0,14,0" Margin="3,5,3,0"
                                  SelectionChanged="FileItemListView_SelectionChanged">

                        <!-- 最简 ItemContainer：裸 ContentPresenter，无 VSM/Transition -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter x:Name="ContentPresenter"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyPhotoFileItem">
                                <!-- 核心修复：BorderThickness 始终 2px，未选中时透明 → 内容位置纹丝不动 -->
                                <Border x:Name="CardRoot" CornerRadius="8" Padding="8,8,8,8"
                                        Margin="0" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="2"
                                        Loaded="CardRoot_Loaded"
                                        DataContextChanged="CardRoot_DataContextChanged"
                                        PointerEntered="CardRoot_PointerEntered"
                                        PointerExited="CardRoot_PointerExited"
                                        PointerPressed="CardRoot_PointerPressed"
                                        PointerReleased="CardRoot_PointerReleased">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 缩略图：抄 SplitPage 的 Grid + FontIcon占位 + Image 模式 -->
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="5"
                                                Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <FontIcon Glyph="&#xE722;" FontSize="18"
                                                          Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneWay}"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayFileName, Mode=OneWay}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind FileInfoSubLine, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <!-- 日期 + LIVE 徽标横排 -->
                                            <Grid>
                                                <TextBlock Text="{x:Bind DateTaken}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           MaxLines="1" HorizontalAlignment="Left"/>
                                                <Border Background="{ThemeResource SystemAccentColor}"
                                                        CornerRadius="3" Padding="4,1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Visibility="{x:Bind LivePhotoBadgeVisibility, Mode=OneWay}">
                                                    <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- 拖拽视觉反馈覆盖层（后渲染 → 始终在 ListView 之上）。
                 三层结构：半透明遮罩 + 虚线描边 + 图标文字，各层独立 Opacity 互不传染。 -->
            <Grid x:Name="DragOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                <!-- Layer 0：半透明黑遮暗背景，让白色文字清晰可读 -->
                <Border Background="#90000000" CornerRadius="10"/>
                <!-- Layer 1：虚线描边（强调色，{ThemeResource} 自动跟随系统变化） -->
                <Rectangle Stroke="White"
                           StrokeThickness="2" StrokeDashArray="6,3"
                           RadiusX="10" RadiusY="10" Margin="4"/>
                <!-- Layer 2：文件夹图标 + 提示文字 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="36"
                              Foreground="White"/>
                    <TextBlock Text="释放以浏览此文件夹"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            </Grid>   <!-- 关闭外层 Grid（Border 的子元素） -->
            </Border>

            <!-- ························································ -->
            <!-- 右侧：Border 包裹作为拖拽目标                              -->
            <!-- ························································ -->
            <Border x:Name="RightPanelBorder" Grid.Column="2"
                    AllowDrop="True" Background="Transparent">
                <Grid>
                    <!-- 内层 Grid：原右侧三行内容 -->
                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 图片预览（PhotoViewer：高性能 Image+CompositeTransform 架构）── -->
                <Border x:Name="PreviewBorder" Grid.Row="0" Style="{StaticResource CardBorderStyle}"
                        Padding="0" Margin="0,0,0,4">
                    <Grid>
                        <!-- 大图查看器：占满整个预览区 -->
                        <controls:PhotoViewer x:Name="PhotoViewer"
                                              ImageSource="{x:Bind ViewModel.PreviewImageSource, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- 缩放控件 + 最大化（浮动在右上角，覆盖在 PhotoViewer 上方） -->
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="6,6,6,0">
                            <Button x:Uid="KeyPhotoPage_ZoomOutBtn"
                                    Width="28" Height="28" Padding="0" CornerRadius="5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Click="ZoomOutButton_Click"
                                    ToolTipService.ToolTip="缩小">
                                <FontIcon Glyph="&#xE949;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button x:Uid="KeyPhotoPage_ZoomResetBtn"
                                    x:Name="ZoomPercentButton"
                                    Width="36" Height="28" Padding="0" CornerRadius="5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Click="ZoomPercentButton_Click"
                                    ToolTipService.ToolTip="适应屏幕 / 100%">
                                <TextBlock x:Name="ZoomPercentText" Text="100%" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                            <Button x:Uid="KeyPhotoPage_ZoomInBtn"
                                    Width="28" Height="28" Padding="0" CornerRadius="5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Click="ZoomInButton_Click"
                                    ToolTipService.ToolTip="放大">
                                <FontIcon Glyph="&#xE948;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Border Width="1" Height="16"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                    VerticalAlignment="Center" Margin="2,0"/>
                            <Button x:Name="MaximizeButton"
                                    x:Uid="KeyPhotoPage_MaximizeButton"
                                    Width="28" Height="28" Padding="0" CornerRadius="5"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Click="MaximizeButton_Click"
                                    ToolTipService.ToolTip="最大化预览">
                                <FontIcon x:Name="MaximizeButtonIcon" Glyph="&#xE922;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── 时间轴（双模式：经典 ListView / 胶片固定选中框）── -->
                <Border x:Name="TimelinePanel" Grid.Row="1" Style="{StaticResource CardBorderStyle}"
                        Padding="10,5,10,4" Margin="0,0,0,4">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ── Row 0：标题 + 帧信息 ── -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8B2;" FontSize="13"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Uid="KeyPhotoPage_TimelineTitle"
                                           Text="Live Photo 时间轴" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <ProgressRing Width="12" Height="12" IsIndeterminate="True"
                                              VerticalAlignment="Center" Margin="4,0,0,0"
                                              Opacity="{x:Bind ViewModel.TimelineLoadingOpacity, Mode=OneWay}"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}">
                                    <ProgressRing.RenderTransform>
                                        <TranslateTransform Y="2"/>
                                    </ProgressRing.RenderTransform>
                                </ProgressRing>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.TimelineInfo, Mode=OneWay}"
                                           FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- ══════════════════════════════════════════════════════════════ -->
                        <!-- ── Row 1 A：经典模式（ListView）                           ── -->
                        <!-- ══════════════════════════════════════════════════════════════ -->
                        <Border x:Name="ClassicTimelineBorder" Grid.Row="1"
                                Visibility="{x:Bind ViewModel.IsClassicTimelineMode, Mode=OneWay}"
                                Height="80" Padding="0">
                            <ListView x:Name="TimelineListView"
                                      ItemsSource="{x:Bind ViewModel.TimelineFrames, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTimelineFrame, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      Padding="0,6,0,14"
                                      Loaded="TimelineListView_Loaded"
                                      SelectionChanged="TimelineListView_SelectionChanged"
                                      ItemContainerTransitions="{x:Null}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="IsTabStop" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter x:Name="ContentPresenter"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TimelineFrame">
                                        <Border x:Name="ClassicTimelineCardRoot" Width="56" Height="56" CornerRadius="5"
                                                Background="Transparent" BorderThickness="2"
                                                BorderBrush="Transparent"
                                                VerticalAlignment="Top">
                                            <Grid>
                                                <!-- 帧缩略图 54×54 内嵌于 56×56 卡片中（多 2px 溢出盖白边） -->
                                                <Border Width="54" Height="54" CornerRadius="4"
                                                        Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE722;" FontSize="18"
                                                                  Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneWay}"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>
                                                <!-- 帧角标：照片帧=金色⭐，视频帧=半透明黑数字 -->
                                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                        Margin="2,0,0,2" CornerRadius="2" Padding="3,1"
                                                        Background="{x:Bind FrameBadgeBackground, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind FrameBadgeText, Mode=OneWay}"
                                                               FontSize="8" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════════ -->
                        <!-- ── Row 1 B：胶片模式（ScrollViewer 强制居中式单帧吸附）  ── -->
                        <!-- ══════════════════════════════════════════════════════════════ -->
                        <Grid Grid.Row="1"
                              Visibility="{x:Bind ViewModel.IsFilmstripTimelineMode, Mode=OneWay}"
                              Height="74" x:Name="FilmstripRoot">

                            <!-- ScrollViewer 柔性吸附 + 动态边缘 Padding。
                                 Optional = 允许惯性多帧滚动，停下后自动居中对齐；
                                 Padding = viewportWidth/2 - itemWidth/2，首末帧可到中心。
                                 ZoomMode="Disabled" 防止手势缩放干扰。 -->
                            <ScrollViewer x:Name="FilmstripScrollViewer"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled"
                                          HorizontalSnapPointsType="Optional"
                                          HorizontalSnapPointsAlignment="Center"
                                          ZoomMode="Disabled"
                                          Loaded="FilmstripScrollViewer_Loaded"
                                          SizeChanged="FilmstripScrollViewer_SizeChanged"
                                          ViewChanged="FilmstripScrollViewer_ViewChanged">
                                <!-- Padding 在 SizeChanged 中动态计算更新 -->
                                <Border x:Name="FilmstripPaddingBorder" Padding="0">
                                    <ItemsRepeater x:Name="TimelineRepeater"
                                                   ItemsSource="{x:Bind ViewModel.TimelineFrames, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="0"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:TimelineFrame">
                                                <!-- 帧卡片 56×56：透明背景无选中态（选中框是固定覆盖层） -->
                                                <Border Width="56" Height="56" CornerRadius="5"
                                                        Background="Transparent" BorderThickness="0">
                                                    <Grid>
                                                        <!-- 帧缩略图 54×54（多 2px 溢出盖白边） -->
                                                        <Border Width="54" Height="54" CornerRadius="4"
                                                                Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Grid>
                                                                <FontIcon Glyph="&#xE722;" FontSize="18"
                                                                          Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneWay}"
                                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                                                            </Grid>
                                                        </Border>
                                                        <!-- 帧角标：照片帧=金色⭐，视频帧=半透明黑数字 -->
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                Margin="2,0,0,2" CornerRadius="2" Padding="3,1"
                                                                Background="{x:Bind FrameBadgeBackground, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind FrameBadgeText, Mode=OneWay}"
                                                                       FontSize="8" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Border>
                            </ScrollViewer>

                            <!-- ▸▸▸ 中层：固定选中框覆盖层（始终在画面中心，IsHitTestVisible=False）▸▸▸ -->
                            <Border x:Name="FilmstripSelectionHighlight"
                                    Width="56" Height="56" CornerRadius="5"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind ViewModel.FilmstripControlsVisibility, Mode=OneWay}"/>

                            <!-- ▸▸▸ 顶层：前/后帧切换按钮（Click → 统一滚动管线）▸▸▸ -->
                            <Button x:Name="FilmstripPrevFrameButton"
                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Click="FilmstripPrevButton_Click"
                                    IsEnabled="{x:Bind ViewModel.HasTimelineFrames, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilmstripControlsVisibility, Mode=OneWay}"
                                    x:Uid="KeyPhotoPage_PrevFrame" ToolTipService.ToolTip="上一帧">
                                <FontIcon Glyph="&#xE76B;" FontSize="10"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <Button x:Name="FilmstripNextFrameButton"
                                    Width="24" Height="24" Padding="0" CornerRadius="12"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Click="FilmstripNextButton_Click"
                                    IsEnabled="{x:Bind ViewModel.HasTimelineFrames, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilmstripControlsVisibility, Mode=OneWay}"
                                    x:Uid="KeyPhotoPage_NextFrame" ToolTipService.ToolTip="下一帧">
                                <FontIcon Glyph="&#xE76C;" FontSize="10"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── 统一信息面板（最小高度锁死，避免切换文件时抖动）── -->
                <Border x:Name="InfoPanel" Grid.Row="2" Style="{StaticResource InfoCardBorderStyle}"
                        MinHeight="100">
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0：缩略图（1:1 方形，复用列表已加载的缩略图） -->
                        <Border Grid.Column="0" x:Name="InfoThumbBorder"
                                Width="80" Height="80" CornerRadius="10" VerticalAlignment="Center"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE722;" FontSize="28"
                                          Visibility="{x:Bind ViewModel.SelectedFileThumbnailPlaceholderVisibility, Mode=OneWay}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{x:Bind ViewModel.SelectedFileThumbnail, Mode=OneWay}"
                                       Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Col 1：照片 + Live Photo 信息 -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind ViewModel.PhotoFileName, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- 照片信息行：可点击 → 文件资源管理器中定位照片 -->
                            <Button Style="{StaticResource InfoRowButtonStyle}"
                                    x:Uid="KeyPhotoPage_LocatePhoto"
                                    Click="LocatePhotoFile_Click"
                                    Visibility="{x:Bind ViewModel.IsPhotoRowVisible, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE722;" FontSize="11"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              VerticalAlignment="Center"
                                              Visibility="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind ViewModel.PhotoInfoLine, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- 视频信息行：可点击 → 文件资源管理器中定位视频 -->
                            <Button Style="{StaticResource InfoRowButtonStyle}"
                                    x:Uid="KeyPhotoPage_LocateVideo"
                                    Click="LocateVideoFile_Click"
                                    Visibility="{x:Bind ViewModel.IsVideoRowVisible, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE714;" FontSize="11"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              VerticalAlignment="Center"
                                              Visibility="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind ViewModel.VideoInfoLine, Mode=OneWay}"
                                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <!-- 协议信息行（实况照片图标 + 协议文字） -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}">
                                <Path Data="M11 12a1 1 0 1 0 2 0a1 1 0 1 0-2 0 M7 12a5 5 0 1 0 10 0a5 5 0 1 0-10 0m8.9 8.11v.01m3.14-2.51v.01M20.77 14v.01m0-4.01v.01m-1.73-3.62v.01M15.9 3.89v.01M12 3v.01m-3.9.88v.01M4.96 6.39v.01M3.23 10v.01m0 3.99v.01m1.73 3.6v.01m3.14 2.49v.01M12 21v.01"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                      StrokeThickness="1" Fill="Transparent"
                                      VerticalAlignment="Center" Margin="-1,1,0,0"/>
                                <TextBlock Text="{x:Bind ViewModel.ProtocolLine, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 竖线分割 -->
                        <Border Grid.Column="2" Width="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                VerticalAlignment="Stretch" Margin="0,2"
                                Visibility="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}"/>

                        <!-- Col 3：EXIF 信息（空行自动折叠） -->
                        <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Top">

                            <!-- 设备名（粗体）+ 日期（细灰）同行显示 -->
                            <TextBlock Visibility="{x:Bind ViewModel.ExifCamera, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True">
                                <Run Text="{x:Bind ViewModel.ExifCamera, Mode=OneWay}"
                                     FontWeight="SemiBold" FontSize="12"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Run Text="{x:Bind ViewModel.ExifCameraDateSuffix, Mode=OneWay}"
                                     FontSize="11"
                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </TextBlock>

                            <!-- 镜头参数 -->
                            <TextBlock Text="{x:Bind ViewModel.ExifLensParams, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.ExifLensParams, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"/>

                            <!-- 拍摄参数 -->
                            <TextBlock Text="{x:Bind ViewModel.ExifShootingParams, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.ExifShootingParams, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"/>

                            <!-- 反向地理编码地名 -->
                            <TextBlock Text="{x:Bind ViewModel.ExifPlaceName, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.ExifPlaceName, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- 关闭内层 Grid ────────────────────────────── -->

            <!-- 右侧拖拽视觉反馈覆盖层（遮罩 + 虚线 + 图标文字） -->
            <Grid x:Name="RightDragOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                <!-- Layer 0：半透明黑遮暗背景 -->
                <Border Background="#90000000" CornerRadius="10"/>
                <!-- Layer 1：虚线描边（强调色） -->
                <Rectangle Stroke="White"
                           StrokeThickness="2" StrokeDashArray="6,3"
                           RadiusX="10" RadiusY="10" Margin="4"/>
                <!-- Layer 2：图标 + 文字 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8B2;" FontSize="36"
                              Foreground="White"/>
                    <TextBlock Text="释放以查看此文件"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- 关闭外层 Grid（Border 子元素） -->
            </Border>
            <!-- 关闭 RightPanelBorder ──────────────────────── -->
        </Grid>
    </Grid>
</Page>
