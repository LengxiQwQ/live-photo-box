<!-- 实况照片修复页：扫描目录，诊断配对问题并执行修复 -->
<Page
    x:Class="LivePhotoBox.Views.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LivePhotoBox.Models"
    mc:Ignorable="d" Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <Grid Padding="24,24,24,40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="12">

                <Expander IsExpanded="{x:Bind ViewModel.IsDirectoryPanelOpen, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource CardBackgroundBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Height="32">
                            <FontIcon Glyph="&#xE7C5;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Uid="RepairPage_ConfigHeader" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Padding="0,4,0,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Uid="RepairPage_InputLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Width="75" Visibility="{x:Bind ViewModel.InputLabelVisibility, Mode=OneWay}"/>
                                <TextBlock x:Uid="RepairPage_InputOutputLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="{x:Bind ViewModel.InputOutputLabelVisibility, Mode=OneWay}"/>
                                <TextBox x:Uid="RepairPage_InputBox" Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanEditInputConfiguration, Mode=OneWay}"/>
                                <Button x:Uid="RepairPage_BrowseBtn1" Grid.Row="0" Grid.Column="2" Command="{x:Bind ViewModel.PickInputDirectoryCommand}" IsEnabled="{x:Bind ViewModel.CanEditInputConfiguration, Mode=OneWay}"/>
                                <Button x:Uid="RepairPage_OpenInputBtn" Grid.Row="0" Grid.Column="3" Command="{x:Bind ViewModel.OpenRepairInputFolderCommand}" Margin="8,0,0,0" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.InputLabelVisibility, Mode=OneWay}"/>
                                <Button x:Uid="RepairPage_OpenInputOutputBtn" Grid.Row="0" Grid.Column="3" Command="{x:Bind ViewModel.OpenRepairInputFolderCommand}" Margin="8,0,0,0" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.InputOutputLabelVisibility, Mode=OneWay}"/>

                                <TextBlock x:Uid="RepairPage_OutputLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Width="75" Margin="0,12,0,0" Visibility="{x:Bind ViewModel.OutputGridVisibility, Mode=OneWay}"/>
                                <TextBox x:Uid="RepairPage_OutputBox" Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,12,0,0" Visibility="{x:Bind ViewModel.OutputGridVisibility, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEditOutputConfiguration, Mode=OneWay}"/>
                                <Button x:Uid="RepairPage_BrowseBtn2" Grid.Row="1" Grid.Column="2" Command="{x:Bind ViewModel.PickOutputDirectoryCommand}" Margin="0,12,0,0" Visibility="{x:Bind ViewModel.OutputGridVisibility, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEditOutputConfiguration, Mode=OneWay}"/>
                                <Button x:Uid="RepairPage_OpenOutputBtn" Grid.Row="1" Grid.Column="3" Command="{x:Bind ViewModel.OpenRepairOutputFolderCommand}" Margin="8,12,0,0" HorizontalAlignment="Stretch" Visibility="{x:Bind ViewModel.OutputGridVisibility, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- 统计栏（左对齐上下两两成对 + 右侧输出模式/扫描按钮水平并列） -->
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,8,16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 第一对：总照片数 / 配对成功（共享列宽，上下数字左对齐） -->
                        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="RepairPage_StatTotalPhotos" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.TotalPhotosCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="RepairPage_StatPaired" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.TotalPairsCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="6,4,0,0"/>
                        </Grid>

                        <!-- 第二对：正常 / 单独照片（共享列宽，上下数字左对齐） -->
                        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="RepairPage_StatThumbCorrect" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ThumbCorrectCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="RepairPage_StatStandaloneImg" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.StandaloneImagesCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="6,4,0,0"/>
                        </Grid>

                        <!-- 第三对：异常 / 单独视频（共享列宽，上下数字左对齐） -->
                        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="RepairPage_StatThumbError" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ThumbErrorCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="RepairPage_StatStandaloneVid" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.StandaloneVideosCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="6,4,0,0"/>
                        </Grid>

                        <!-- 右侧：输出模式 + 扫描按钮水平并列，跨两行垂直居中 -->
                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="6"
                                    Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                            <TextBlock x:Uid="RepairPage_OutputModeLabel" FontSize="14" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Uid="RepairPage_OutputSwitch"
                                          IsOn="{x:Bind ViewModel.IsOutputToDirectory, Mode=TwoWay}"
                                          FontSize="14"/>
                            <Button x:Uid="RepairPage_HelpBtn" Height="34" Width="34" Padding="0"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.GoToTutorialCommand}" CommandParameter="Repair">
                                <FontIcon Glyph="&#xE9CE;" FontSize="16"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Uid="RepairPage_SettingsBtn" Height="34" Width="34" Padding="0"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="GoToRepairSettings_Click">
                                <FontIcon Glyph="&#xE90F;" FontSize="16"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ScanDirectoryCommand}"
                                    Content="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}"
                                    Style="{x:Bind ViewModel.ScanButtonStyle, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsNotProcessing, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Padding="16,10,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                            <Run x:Uid="RepairPage_QueueProgress"/>
                            <Run Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"/>
                        </TextBlock>
                        <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="{x:Bind ViewModel.ProgressBarState, Converter={StaticResource ProgressBarForegroundConverter}, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.ProgressBarState, Converter={StaticResource ProgressBarIndeterminateConverter}, Mode=OneWay}" MaxWidth="400" HorizontalAlignment="Left"/>
                        <!-- 当前浏览分组（滚动感知） -->
                        <TextBlock Margin="0,-5,0,0"
                                   Visibility="{x:Bind ViewModel.ViewGroupVisibility, Mode=OneWay}"
                                   Text="{x:Bind ViewModel.CurrentViewGroupText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>

                    <!-- 筛选区（左对齐，固定距左侧） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">

                        <TextBlock x:Uid="RepairPage_FilterLabel"
                                   FontSize="14" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.FilterBarVisibility, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <DropDownButton x:Name="FilterDropDown"
                                            Content="{x:Bind ViewModel.CombinedFilterText, Mode=OneWay}"
                                            Height="34" FontSize="14"
                                            Visibility="{x:Bind ViewModel.FilterBarVisibility, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.IsFilterEnabled, Mode=OneWay}"
                                            Loaded="FilterDropDown_Loaded">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom" Opening="FilterFlyout_Opening">
                                        <MenuFlyoutItem IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuFlyoutItem Tag="TypeFilter_0"
                                                        Command="{x:Bind ViewModel.SetTypeFilterCommand}" CommandParameter="0"/>
                                        <MenuFlyoutItem Tag="TypeFilter_1"
                                                        Command="{x:Bind ViewModel.SetTypeFilterCommand}" CommandParameter="1"/>
                                        <MenuFlyoutItem Tag="TypeFilter_2"
                                                        Command="{x:Bind ViewModel.SetTypeFilterCommand}" CommandParameter="2"/>
                                        <MenuFlyoutItem Tag="TypeFilter_3"
                                                        Command="{x:Bind ViewModel.SetTypeFilterCommand}" CommandParameter="3"/>
                                        <MenuFlyoutSeparator x:Name="FilterMenuSeparator"/>
                                        <MenuFlyoutItem IsEnabled="False" FontWeight="SemiBold"/>
                                        <MenuFlyoutItem Tag="StatusFilter_0"
                                                        Command="{x:Bind ViewModel.SetStatusFilterCommand}" CommandParameter="0"/>
                                        <MenuFlyoutItem Tag="StatusFilter_1"
                                                        Command="{x:Bind ViewModel.SetStatusFilterCommand}" CommandParameter="1"/>
                                        <MenuFlyoutItem Tag="StatusFilter_2"
                                                        Command="{x:Bind ViewModel.SetStatusFilterCommand}" CommandParameter="2"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <Button x:Uid="RepairPage_ResetFilterBtn" Width="33" Height="33" Padding="0"
                                    Command="{x:Bind ViewModel.ResetFilterCommand}"
                                    Visibility="{x:Bind ViewModel.FilterBarVisibility, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsFilterEnabled, Mode=OneWay}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>

                    <!-- 操作按钮（右对齐） -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center" HorizontalAlignment="Right">


                        <Button Content="{x:Bind ViewModel.SecondaryBtnText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleSecondaryActionCommand}"
                                IsEnabled="{x:Bind ViewModel.IsNotScanning, Mode=OneWay}"
                                MinWidth="80" Height="34" FontSize="14"/>

                        <Button Content="{x:Bind ViewModel.ActionBtnText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleProcessCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.IsProcessingAllowed, Mode=OneWay}"
                                MinWidth="100" Height="36" FontSize="14"
                                Margin="16,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 固定表头（始终可见，不随列表滚动） -->
                    <Grid Grid.Row="0" Padding="12,0,12,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="2.10*"/>
                            <ColumnDefinition Width="1.85*"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Uid="RepairPage_ColSeq" Grid.Column="0" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Uid="RepairPage_ColFile" Grid.Column="1" Grid.ColumnSpan="2" Margin="4,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Uid="RepairPage_ColIssue" Grid.Column="3" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Uid="RepairPage_ColStatus" Grid.Column="4" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <ListView x:Name="RepairTaskListView" Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredTasks}" SelectionMode="None" ShowsScrollingPlaceholders="False" ContainerContentChanging="RepairTaskListView_ContainerContentChanging">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel AreStickyGroupHeadersEnabled="False" CacheLength="4" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RepairTask">
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="{x:Bind GridPadding, Mode=OneWay}">
                                <Grid ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="2.10*"/>
                                            <ColumnDefinition Width="1.85*"/>
                                            <ColumnDefinition Width="1.35*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{x:Bind Row0Height, Mode=OneWay}"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="{x:Bind Row2Height, Mode=OneWay}"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: 序号1 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind File1Index, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <!-- 缩略图（配对）— 48×48 -->
                                        <Button x:Uid="RepairPage_TipApp" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,4,0" Click="ThumbnailButton_Click" Tag="{x:Bind File1Path, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="6" Visibility="{x:Bind PairedThumbnailVisibility, Mode=OneWay}">
                                            <Border Width="48" Height="48" CornerRadius="7" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                                                <Grid>
                                                    <TextBlock x:Uid="RepairPage_ThumbnailLoadingText" Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="9"/>
                                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                        </Button>

                                        <!-- 缩略图（单独）— 48×48 -->
                                        <Button x:Uid="RepairPage_TipApp" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,4,0" Click="ThumbnailButton_Click" Tag="{x:Bind File1Path, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="6" Visibility="{x:Bind StandaloneThumbnailVisibility, Mode=OneWay}">
                                            <Border Width="48" Height="48" CornerRadius="7" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                                                <Grid>
                                                    <TextBlock x:Uid="RepairPage_ThumbnailLoadingText" Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="9"/>
                                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                        </Button>

                                        <!-- Row 0 File1 -->
                                        <Button x:Uid="RepairPage_TipFolder" Grid.Row="0" Grid.Column="2" Click="FileButton_Click" Tag="{x:Bind File1Path, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="3" HorizontalAlignment="Left" HorizontalContentAlignment="Left" CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" Spacing="5" Height="22">
                                                <FontIcon Glyph="{x:Bind File1IconGlyph, Mode=OneWay}" Foreground="{x:Bind File1IconForeground, Mode=OneWay}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center" Text="{x:Bind File1Name, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" Text="{x:Bind File1IssueDescription, Mode=OneWay}" Foreground="{x:Bind File1IsDiagnosisError, Converter={StaticResource BoolToDiagnosisErrorBrushConverter}, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTapEnabled="{x:Bind File1IsDiagnosisError, Mode=OneWay}" Tapped="IssueDescription_Tapped" Tag="1"/>

                                        <TextBlock Grid.Row="0" Grid.Column="4" Margin="10,0,0,0" Text="{x:Bind File1Details, Mode=OneWay}" Foreground="{x:Bind File1DisplayStatus, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTapEnabled="True" Tapped="StatusTextBlock_Tapped" Tag="1"/>

                                        <!-- Row 1: 配对分隔线 — 横跨文件→问题→状态 -->
                                        <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                                                Visibility="{x:Bind File2Visibility, Mode=OneWay}"
                                                Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                Margin="0,14,0,14"/>

                                        <!-- Row 2: 序号2 + File2 + Issue2 + Status2 — 仅配对时显示 -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind File2Index, Mode=OneWay}" Visibility="{x:Bind File2Visibility, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <Button x:Uid="RepairPage_TipFolder" Grid.Row="2" Grid.Column="2" Visibility="{x:Bind File2Visibility, Mode=OneWay}" Click="FileButton_Click" Tag="{x:Bind File2Path, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="3" HorizontalAlignment="Left" HorizontalContentAlignment="Left" CornerRadius="4">
                                            <StackPanel Orientation="Horizontal" Spacing="5" Height="22">
                                                <FontIcon Glyph="{x:Bind File2IconGlyph, Mode=OneWay}" Foreground="{x:Bind File2IconForeground, Mode=OneWay}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center" Text="{x:Bind File2Name, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="8,0,0,0" Visibility="{x:Bind File2Visibility, Mode=OneWay}" Text="{x:Bind File2IssueDescription, Mode=OneWay}" Foreground="{x:Bind File2IsDiagnosisError, Converter={StaticResource BoolToDiagnosisErrorBrushConverter}, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTapEnabled="{x:Bind File2IsDiagnosisError, Mode=OneWay}" Tapped="IssueDescription_Tapped" Tag="2"/>

                                        <TextBlock Grid.Row="2" Grid.Column="4" Margin="10,0,0,0" Visibility="{x:Bind File2Visibility, Mode=OneWay}" Text="{x:Bind File2Details, Mode=OneWay}" Foreground="{x:Bind File2DisplayStatus, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTapEnabled="True" Tapped="StatusTextBlock_Tapped" Tag="2"/>
                                    </Grid>
                                </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </Grid>
            </Border>

        </Grid>

        <TeachingTip x:Name="ErrorDetailTip"
                     IsLightDismissEnabled="False"
                     PreferredPlacement="Left"
                     Closed="ErrorDetailTip_Closed">
            <TeachingTip.Content>
                <TextBlock x:Name="ErrorDetailText" MaxWidth="520" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,36,0"/>
            </TeachingTip.Content>
        </TeachingTip>

    </Grid>
</Page>