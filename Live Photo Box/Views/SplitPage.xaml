<Page
    x:Class="LivePhotoBox.Views.SplitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LivePhotoBox.Models"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <!-- 实况照片拆分页：将实况照片拆分为独立的照片和视频 -->
    <Grid>
        <Grid Padding="24,24,24,40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="12">

                <!-- 配置面板 -->
                <Expander IsExpanded="{x:Bind ViewModel.IsDirectoryPanelOpen, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource CardBackgroundBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Height="32">
                            <FontIcon Glyph="&#xE8C6;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Uid="SplitPage_ConfigHeader" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Padding="0,4,0,0">
                            <Grid ColumnSpacing="8" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Uid="SplitPage_InputLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Width="75"/>
                                <TextBox x:Uid="SplitPage_InputBox" Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.InputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanEditInputConfiguration, Mode=OneWay}"/>
                                <Button x:Uid="SplitPage_BrowseBtn1" Grid.Row="0" Grid.Column="2" Click="BrowseInput_Click" IsEnabled="{x:Bind ViewModel.CanEditInputConfiguration, Mode=OneWay}"/>
                                <Button x:Uid="SplitPage_OpenInputBtn" Grid.Row="0" Grid.Column="3" Command="{x:Bind ViewModel.OpenSplitInputFolderCommand}" Margin="8,0,0,0" HorizontalAlignment="Stretch"/>

                                <TextBlock x:Uid="SplitPage_OutputLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Width="75"/>
                                <TextBox x:Uid="SplitPage_OutputBox" Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanEditOutputConfiguration, Mode=OneWay}"/>
                                <Button x:Uid="SplitPage_BrowseBtn2" Grid.Row="1" Grid.Column="2" Click="BrowseOutput_Click" IsEnabled="{x:Bind ViewModel.CanEditOutputConfiguration, Mode=OneWay}"/>
                                <Button x:Uid="SplitPage_OpenOutputBtn" Grid.Row="1" Grid.Column="3" Command="{x:Bind ViewModel.OpenSplitOutputFolderCommand}" Margin="8,0,0,0" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="16,10,16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Uid="SplitPage_StatRecognized" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.RecognizedCount, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Uid="SplitPage_StatSkipped" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.SkippedCount, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- 视频输出格式 — 从设置页移至此处，方便快速切换 -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Uid="SplitPage_FormatLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedFormatIndex, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanEditSelectedFormat, Mode=OneWay}" Loaded="FormatComboBox_Loaded">
                                    <ComboBoxItem x:Uid="SettingsPage_SplitFormat_ImageDefault"/>
                                    <ComboBoxItem x:Uid="SettingsPage_SplitFormat_MP4"/>
                                    <ComboBoxItem x:Uid="SettingsPage_SplitFormat_MOV"/>
                                </ComboBox>
                            </StackPanel>

                            <Button x:Uid="SplitPage_HelpBtn" Height="34" Width="34" Padding="0"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.GoToTutorialCommand}" CommandParameter="Split">
                                <FontIcon Glyph="&#xE9CE;" FontSize="16"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <!-- 拆分设置已全部移至本页，暂时隐藏设置入口
                            <Button x:Uid="SplitPage_SettingsBtn" Height="34" Width="34" Padding="0"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Click="GoToSplitSettings_Click">
                                <FontIcon Glyph="&#xE90F;" FontSize="16"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            -->
                            <Button
                                Command="{x:Bind ViewModel.ScanDirectoryCommand}"
                                Content="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}"
                                Style="{x:Bind ViewModel.ScanButtonStyle, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanClickScanButton, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Padding="16,10,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                            <Run x:Uid="SplitPage_QueueProgress"/>
                            <Run Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"/>
                        </TextBlock>
                        <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="{x:Bind ViewModel.ProgressBarState, Converter={StaticResource ProgressBarForegroundConverter}, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.ProgressBarState, Converter={StaticResource ProgressBarIndeterminateConverter}, Mode=OneWay}" MaxWidth="400" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Right">

                        <Button Content="{x:Bind ViewModel.SecondaryBtnText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSecondaryActionCommand}" IsEnabled="{x:Bind ViewModel.IsNotScanning, Mode=OneWay}" MinWidth="80" Height="34" FontSize="14"/>
                        <Button Content="{x:Bind ViewModel.ActionBtnText, Mode=OneWay}" Command="{x:Bind ViewModel.StartProcessingCommand}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.IsProcessingAllowed, Mode=OneWay}" MinWidth="100" Height="36" FontSize="14" Margin="16,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 任务列表 -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="8" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,0,12,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="2.7*"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1.85*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Uid="SplitPage_ColSeq" Grid.Column="0" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Uid="SplitPage_ColSourceHeader" Grid.Column="1" Grid.ColumnSpan="2" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Uid="SplitPage_ColSize" Grid.Column="3" Margin="14,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Uid="SplitPage_ColStatusHeader" Grid.Column="4" Margin="32,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <ListView x:Name="SplitTaskListView" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tasks}" SelectionMode="None" ShowsScrollingPlaceholders="False" ContainerContentChanging="SplitTaskListView_ContainerContentChanging">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel AreStickyGroupHeadersEnabled="False" CacheLength="4" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SplitTask">
                                <Border Height="66" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6,10,6">
                                <Grid ColumnSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="2.7*"/>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="1.85*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind Index}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <Button x:Uid="SplitPage_TipApp" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0" Click="ThumbnailButton_Click" Tag="{x:Bind SourcePath}" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="6">
                                        <Border Width="52" Height="52" CornerRadius="7" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                                            <Grid>
                                                <TextBlock x:Uid="SplitPage_ThumbnailLoadingText" Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="9" Margin="4"/>
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button x:Uid="SplitPage_TipFolder" Grid.Column="2" Click="FileButton_Click" Tag="{x:Bind SourcePath}" Background="Transparent" BorderThickness="0" Padding="3" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalAlignment="Center" CornerRadius="4">
                                        <TextBlock FontSize="13" VerticalAlignment="Center" Text="{x:Bind DisplaySourceFileName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </Button>

                                    <TextBlock Grid.Column="3" Margin="14,0,0,0" Text="{x:Bind FileSize}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                                    <TextBlock Grid.Column="4" Margin="32,0,0,0" Text="{x:Bind DisplayStatus, Mode=OneWay}" Foreground="{x:Bind Status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" IsTapEnabled="True" Tapped="StatusTextBlock_Tapped"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                    <!-- 队列为空占位提示 -->
                    <StackPanel Grid.Row="1"
                                Visibility="{x:Bind ViewModel.EmptyQueueVisibility, Mode=OneWay}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="14" Margin="0">
                        <TextBlock x:Uid="SplitPage_EmptyQueueTitle"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="SplitPage_EmptyQueueDesc"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="WrapWholeWords"
                                   MaxWidth="520" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,28,0,0">
                            <TextBlock x:Uid="SplitPage_EmptyQueueHint_Part1" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE9CE;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <TextBlock x:Uid="SplitPage_EmptyQueueHint_Part2" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE90F;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <TextBlock x:Uid="SplitPage_EmptyQueueHint_Part3" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 回到顶部悬浮按钮 — 滚动超过 200px 后出现 -->
                    <Button x:Name="ScrollToTopButton"
                            Grid.Row="1"
                            Canvas.ZIndex="100"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Width="32" Height="32"
                            Margin="0,0,12,12"
                            CornerRadius="16"
                            Visibility="Collapsed"
                            IsTabStop="False"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="0"
                            ToolTipService.ToolTip="回到顶部">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                             Color="{ThemeResource SolidBackgroundFillColorSecondary}"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                             Color="{ThemeResource SolidBackgroundFillColorTertiary}"/>
                        </Button.Resources>
                        <Button.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="8"/>
                            </TransitionCollection>
                        </Button.Transitions>
                        <FontIcon Glyph="&#xE70E;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Button>
            </Grid>
            </Border>

        </Grid>

        <TeachingTip x:Name="ErrorDetailTip"
                     IsLightDismissEnabled="False"
                     PreferredPlacement="Left"
                     Closed="ErrorDetailTip_Closed">
            <TeachingTip.Content>
                <TextBlock x:Name="ErrorDetailText" MaxWidth="520" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,36,0"/>
            </TeachingTip.Content>
        </TeachingTip>
    </Grid>
</Page>