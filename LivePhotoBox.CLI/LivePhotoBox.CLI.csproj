<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>livephotobox-boot</AssemblyName>

    <!-- CLI aliases: these names all invoke the same tool -->
    <_CliAliases>livebox;lpb;livephoto</_CliAliases>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 编译期注入构建日期（UTC），供版本与 info 显示 -->
    <BuildDate>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</BuildDate>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LivePhotoBox.Core\LivePhotoBox.Core.csproj" />
  </ItemGroup>

  <!-- 编译时从 Package.appxmanifest 自动同步版本号 -->
  <Target Name="SyncVersionFromManifest" BeforeTargets="BeforeBuild">
    <XmlPeek XmlInputPath="../LivePhotoBox/Package.appxmanifest" Query="/x:Package/x:Identity/@Version" Namespaces="&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
      <Output TaskParameter="Result" PropertyName="_ManifestVersion" />
    </XmlPeek>
    <PropertyGroup Condition="$(_ManifestVersion) != ''">
      <Version>$(_ManifestVersion)</Version>
      <FileVersion>$(_ManifestVersion)</FileVersion>
    </PropertyGroup>
    <Message Importance="high" Text="CLI version synced from Package.appxmanifest: $(_ManifestVersion)" Condition="$(_ManifestVersion) != ''" />
  </Target>

  <!-- 构建后为每个别名复制 exe 及配套文件（Windows 专用） -->
  <Target Name="CreateAliases" AfterTargets="AfterBuild" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <_AliasDestDir Condition="'$(_AliasDestDir)' == ''">$(OutputPath)</_AliasDestDir>
    </PropertyGroup>
    <ItemGroup>
      <_CliAliasItem Include="$(_CliAliases)" />
    </ItemGroup>
    <Message Importance="high" Text="[CLI] Creating aliases in $(_AliasDestDir): @(_CliAliasItem, ', ')" />
    <Copy SourceFiles="$(_AliasDestDir)$(AssemblyName).exe"
          DestinationFiles="$(_AliasDestDir)%(_CliAliasItem.Identity).exe"
          SkipUnchangedFiles="true" />
    <!-- 单文件发布没有独立的 runtimeconfig.json / deps.json（已内嵌到 exe），加 Exists 防 MSB3030 -->
    <Copy SourceFiles="$(_AliasDestDir)$(AssemblyName).runtimeconfig.json"
          DestinationFiles="$(_AliasDestDir)%(_CliAliasItem.Identity).runtimeconfig.json"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_AliasDestDir)$(AssemblyName).runtimeconfig.json')" />
    <Copy SourceFiles="$(_AliasDestDir)$(AssemblyName).deps.json"
          DestinationFiles="$(_AliasDestDir)%(_CliAliasItem.Identity).deps.json"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_AliasDestDir)$(AssemblyName).deps.json')" />
    <Copy SourceFiles="$(_AliasDestDir)$(AssemblyName).pdb"
          DestinationFiles="$(_AliasDestDir)%(_CliAliasItem.Identity).pdb"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_AliasDestDir)$(AssemblyName).pdb')" />
  </Target>

  <!-- Publish 阶段：显式设置目标为 PublishDir -->
  <Target Name="CreateAliasesOnPublish" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="CreateAliases" Properties="_AliasDestDir=$(PublishDir)\" />
  </Target>
</Project>
