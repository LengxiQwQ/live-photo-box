<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>LivePhotoBox</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <NativeRuntimeIdentifier>win-x64</NativeRuntimeIdentifier>
    <NativeArtifactsDir>$(MSBuildThisFileDirectory)..\artifacts\native\$(Configuration)\$(NativeRuntimeIdentifier)</NativeArtifactsDir>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="$(NativeArtifactsDir)\LivePhotoBox.Native.dll">
      <Link>LivePhotoBox.Native.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    dotnet MSBuild cannot load Visual C++ targets directly. For standalone managed
    builds, invoke the same vcxproj through desktop MSBuild. Full solution builds
    use the explicit solution dependency instead.
  -->
  <Target Name="BuildLivePhotoBoxNative"
          BeforeTargets="PrepareForBuild"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(SkipNativeBuild)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingSolutionFile)' != 'true'"
          Inputs="$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\LivePhotoBox.Native.vcxproj;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\LivePhotoBox.Native.vcxproj.filters;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\include\livephotobox_native.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\binary\binary_io.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\binary\endian.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\containers\isobmff.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\foundation\internal.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\image_converter.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\media_cleaner.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\media_extractor.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\media_inspector.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\video_converter.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\metadata\exif.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\metadata\exif_rewrite.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\metadata\jpeg.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\protocols\apple_mebx_templates.h;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\containers\heif.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\containers\isobmff.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\containers\mp4_strip.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\foundation\context.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\image_converter.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\media_api.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\media_cleaner.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\media_extractor.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\media_inspector.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\media\video_converter.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\metadata\exif.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\metadata\exif_rewrite.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\metadata\jpeg.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\protocols\apple.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\protocols\apple_mebx.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\protocols\huawei.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\protocols\samsung_sef.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox.Native\src\protocols\vivo_legacy.cpp;$(MSBuildThisFileDirectory)..\LivePhotoBox\Package.appxmanifest;$(MSBuildThisFileDirectory)..\scripts\native\build-native.ps1"
          Outputs="$(NativeArtifactsDir)\LivePhotoBox.Native.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\scripts\native\build-native.ps1&quot; -Configuration $(Configuration) -Architecture x64" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="..\LivePhotoBox\Strings\en-US\Resources.resw"
                      LogicalName="LivePhotoBox.Strings.en-US.Resources.resw" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>LivePhotoBox.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Magick.NET-Q16-x64" Version="14.16.0" />
    <PackageReference Include="PhotoSauce.MagicScaler" Version="0.15.0" />
    <PackageReference Include="PhotoSauce.NativeCodecs.Libheif" Version="1.19.5-preview1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- 编译时从 Package.appxmanifest 自动同步版本号，�?GUI 保持一�?-->
  <Target Name="SyncVersionFromManifest" BeforeTargets="BeforeBuild">
    <XmlPeek XmlInputPath="../LivePhotoBox/Package.appxmanifest" Query="/x:Package/x:Identity/@Version" Namespaces="&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
      <Output TaskParameter="Result" PropertyName="_ManifestVersion" />
    </XmlPeek>
    <PropertyGroup Condition="$(_ManifestVersion) != ''">
      <Version>$(_ManifestVersion)</Version>
      <FileVersion>$(_ManifestVersion)</FileVersion>
    </PropertyGroup>
    <Message Importance="high" Text="Core version synced from Package.appxmanifest: $(_ManifestVersion)" Condition="$(_ManifestVersion) != ''" />
  </Target>

</Project>


