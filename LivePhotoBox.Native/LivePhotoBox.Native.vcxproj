  <Target Name="GenerateNativeVersionHeader"
          BeforeTargets="ClCompile"
          Inputs="$(ProjectDir)..\LivePhotoBox\Package.appxmanifest"
          Outputs="$(IntDir)livephotobox_native_version.h">
    <XmlPeek XmlInputPath="$(ProjectDir)..\LivePhotoBox\Package.appxmanifest"
             Query="/x:Package/x:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
      <Output TaskParameter="Result" PropertyName="_ManifestVersion" />
    </XmlPeek>
    <Error Condition="'$(_ManifestVersion)' == ''"
           Text="Unable to read the Native product version from LivePhotoBox/Package.appxmanifest." />
    <MakeDir Directories="$(IntDir)" />
    <ItemGroup>
      <_NativeVersionHeaderLine Include="#pragma once" />
      <_NativeVersionHeaderLine Include="#define LPB_PRODUCT_VERSION &quot;$(_ManifestVersion)&quot;" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntDir)livephotobox_native_version.h"
                      Lines="@(_NativeVersionHeaderLine)"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <Message Importance="high" Text="Native version synced from Package.appxmanifest: $(_ManifestVersion)" />
  </Target>

