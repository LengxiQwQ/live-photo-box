<Application
    x:Class="LivePhotoBox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="CyberCyanBrush" Color="#00E5FF"/>
            <SolidColorBrush x:Key="CyberPurpleBrush" Color="#B388FF"/>
            <SolidColorBrush x:Key="ScanCancelButtonBackgroundBrush" Color="#C42B1C"/>
            <SolidColorBrush x:Key="ScanCancelButtonBackgroundPointerOverBrush" Color="#A82418"/>
            <SolidColorBrush x:Key="ScanCancelButtonBackgroundPressedBrush" Color="#8B1E14"/>
            <SolidColorBrush x:Key="ScanCancelButtonForegroundBrush" Color="#FFFFFF"/>

            <Style x:Key="ScanCancelButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ScanCancelButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource ScanCancelButtonForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ScanCancelButtonBackgroundBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="Padding" Value="{ThemeResource ButtonPadding}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                x:Name="RootGrid"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ScanCancelButtonBackgroundPointerOverBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ScanCancelButtonBackgroundPointerOverBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ScanCancelButtonBackgroundPressedBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ScanCancelButtonBackgroundPressedBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" Opacity="0.9"/>
                    <SolidColorBrush x:Key="PageStatusBarBackgroundBrush" Color="#FFF7F7F7" Opacity="0.98"/>
                    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E5E5E5"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF1E1E1E" Opacity="0.95"/>
                    <SolidColorBrush x:Key="PageStatusBarBackgroundBrush" Color="#FF1E1E1E" Opacity="0.98"/>
                    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3D3D3D"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource LayerOnAcrylicFillColorDefault}" Opacity="0.8"/>
                    <SolidColorBrush x:Key="PageStatusBarBackgroundBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.98"/>
                    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E5E5E5"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
