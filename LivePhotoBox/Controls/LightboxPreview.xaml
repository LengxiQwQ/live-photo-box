<UserControl
    x:Class="LivePhotoBox.Controls.LightboxPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <Grid>
        <!-- 全屏灯箱 -->
        <Grid x:Name="LightboxOverlay" Visibility="Collapsed"
              Background="#000000"
              PointerWheelChanged="LightboxOverlay_PointerWheelChanged">
            <Border Background="Transparent" Tapped="LightboxBackdrop_Tapped"/>
            <Button x:Name="LightboxCloseButton"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="16" Width="40" Height="40" CornerRadius="20"
                    Background="#44000000" BorderThickness="0"
                    Click="LightboxCloseButton_Click">
                <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="White"/>
            </Button>
            <Image x:Name="LightboxImage" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsTapEnabled="True" Tapped="LightboxBackdrop_Tapped"/>
            <!-- 双播放器交替切源：永远在隐藏的播放器里设源，可见的从不动源 -->
            <MediaPlayerElement x:Name="LightboxVideo0"
                   Visibility="Collapsed"
                   AutoPlay="True"
                   AreTransportControlsEnabled="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsTapEnabled="True" Tapped="LightboxBackdrop_Tapped"/>
            <MediaPlayerElement x:Name="LightboxVideo1"
                   Visibility="Collapsed"
                   AutoPlay="True"
                   AreTransportControlsEnabled="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsTapEnabled="True" Tapped="LightboxBackdrop_Tapped"/>

            <ProgressRing x:Name="LightboxSpinner"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Width="48" Height="48"
                   Foreground="White"/>
            <Grid x:Name="VideoProgressBar" Visibility="Collapsed"
                  VerticalAlignment="Bottom" Height="3"
                  HorizontalAlignment="Stretch">
                <Border Background="#33FFFFFF" HorizontalAlignment="Stretch"/>
                <Border x:Name="VideoProgressFill" Background="#FFFFFF"
                        HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="VideoTimeLabel" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,6" Foreground="#99FFFFFF" FontSize="12"/>
            <TextBlock x:Name="LightboxCounter"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,22" Foreground="#CCFFFFFF" FontSize="13"/>
        </Grid>
    </Grid>
</UserControl>
