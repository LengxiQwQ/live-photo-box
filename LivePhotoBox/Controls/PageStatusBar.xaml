<UserControl
    x:Class="LivePhotoBox.Controls.PageStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:LivePhotoBox.Converters"
    mc:Ignorable="d"
    Height="32">

    <UserControl.Resources>
        <converters:ProgressBarForegroundConverter x:Key="ProgressBarForegroundConverter" />
    </UserControl.Resources>

    <Border Background="{ThemeResource PageStatusBarBackgroundBrush}">
        <Grid>
            <Grid Margin="16,0,12,0" VerticalAlignment="Center" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind ViewModel.FooterStatusText, Mode=OneWay}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    LineHeight="0"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Opacity="0.9" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.FooterPercentText, Mode=OneWay}"
                        FontSize="11"
                        LineHeight="0"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Right"
                        MinWidth="96"
                        Visibility="{x:Bind ViewModel.FooterPercentVisibility, Mode=OneWay}" />
                    <HyperlinkButton
                        NavigateUri="https://github.com/LengxiQwQ"
                        VerticalAlignment="Center"
                        Opacity="0.5"
                        Padding="4,2"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                        <HyperlinkButton.Content>
                            <TextBlock x:Uid="MainWindow_Footer" FontSize="11" LineHeight="0" />
                        </HyperlinkButton.Content>
                    </HyperlinkButton>
                </StackPanel>
            </Grid>

            <ProgressBar
                VerticalAlignment="Top"
                Height="1"
                Maximum="100"
                Minimum="0"
                Value="{x:Bind ViewModel.FooterProgressBarValue, Mode=OneWay}"
                IsIndeterminate="{x:Bind ViewModel.FooterIsIndeterminate, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                CornerRadius="0"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Foreground="{x:Bind ViewModel.FooterProgressBarState, Mode=OneWay, Converter={StaticResource ProgressBarForegroundConverter}}"
                BorderThickness="0"
                Padding="0" />
        </Grid>
    </Border>
</UserControl>