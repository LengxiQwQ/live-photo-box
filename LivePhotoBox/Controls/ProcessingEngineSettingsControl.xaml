<UserControl
    x:Class="LivePhotoBox.Controls.ProcessingEngineSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <controls:SettingsCard FontFamily="Microsoft YaHei UI">
        <controls:SettingsCard.Header>
            <TextBlock x:Uid="SettingsPage_General_ProcessingVersion" FontFamily="Microsoft YaHei UI"/>
        </controls:SettingsCard.Header>
        <controls:SettingsCard.Description>
            <TextBlock x:Uid="SettingsPage_General_ProcessingVersion_Desc"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </controls:SettingsCard.Description>
        <controls:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE943;" FontSize="16"/>
        </controls:SettingsCard.HeaderIcon>
        <ToggleSwitch x:Name="ProcessingVersionToggle"
                      x:Uid="Toggle_OnOff"
                      Toggled="PipelineToggle_Toggled"/>
    </controls:SettingsCard>
</UserControl>
