<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
			<AnalysisMode>Recommended</AnalysisMode>
			<AnalysisLevel>latest</AnalysisLevel>
			<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<RootNamespace>LivePhotoBox</RootNamespace>
		<AssemblyName>Live Photo Box</AssemblyName>
		<!-- 版本号从 Package.appxmanifest 自动同步，无需手动修改此处 -->
		<Version>1.0.0.0</Version>
		<FileVersion>1.0.0.0</FileVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<Authors>LengxiQwQ</Authors>
		<Company>LengxiQwQ</Company>
		<Product>Live Photo Box</Product>
		<AssemblyTitle>Live Photo Box</AssemblyTitle>
		<Copyright>Copyright © 2026 LengxiQwQ. Licensed under GPL v3.0</Copyright>
		<ApplicationIcon>Assets\Icons\AppIcon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<DefaultLanguage>zh-Hans</DefaultLanguage>
		<SatelliteResourceLanguages>zh-Hans;en-US</SatelliteResourceLanguages>
		
		<!-- 原生 WinAppSDK 框架保留的语言文件夹（Windows 区域名称，分号分隔） -->
		<AppSupportedNativeLocales>en-us;zh-CN</AppSupportedNativeLocales>

		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsSdkPackageVersion>10.0.22621.56</WindowsSdkPackageVersion>

		<AppxBundle>Never</AppxBundle>
		<SelfContained>true</SelfContained>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
		
		<!-- 非打包 Bootstrap 见 Services/WindowsAppSdkBootstrap.cs（ModuleInitializer） -->
	</PropertyGroup>
	
	<ItemGroup>
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-lightunplated_targetsize-16.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-lightunplated_targetsize-24.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-lightunplated_targetsize-256.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-lightunplated_targetsize-32.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-lightunplated_targetsize-48.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-unplated_targetsize-16.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-unplated_targetsize-256.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-unplated_targetsize-32.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.altform-unplated_targetsize-48.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.scale-100.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.scale-125.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.scale-150.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.scale-400.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.targetsize-16.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.targetsize-24.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.targetsize-256.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.targetsize-32.png" />
	  <Content Remove="Assets\Icons\Square44x44Logo.targetsize-48.png" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Views\AboutPage.xaml" />
		<None Remove="Views\MergePage.xaml" />
		<None Remove="Views\HomePage.xaml" />
        <!-- Remove any residual font assets that were deleted from disk but still referenced by the project -->
		<Content Remove="Assets\Fonts\**\*.*" />
		<None Remove="Assets\Fonts\**\*.*" />
		<None Remove="Tools\**" />
	</ItemGroup>

	<ItemGroup>
        <Content Include="Assets\**\*.*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
        <Compile Remove="Tools\**" />
        <EmbeddedResource Remove="Tools\**" />
        <Page Remove="Tools\**" />
		<!-- 外部命令行工具：编译时将整个 Tools 目录复制到构建输出 -->
		<Content Include="Tools\**\*" Condition="Exists('Tools')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- CLI 使用手册：编译时复制到构建输出，供关于页"CLI 手册"按钮本地读取（发布脚本也复制，此处兜底开发/商店版） -->
		<Content Include="..\docs\CLI-User-Guide.md" Condition="Exists('..\docs\CLI-User-Guide.md')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\docs\CLI-User-Guide.zh-CN.md" Condition="Exists('..\docs\CLI-User-Guide.zh-CN.md')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="FluentIcons.WinUI" Version="2.0.320" />
		<PackageReference Include="Magick.NET-Q16-x64" Version="14.16.0" />
		<PackageReference Include="PhotoSauce.MagicScaler" Version="0.15.0" />
		<PackageReference Include="PhotoSauce.NativeCodecs.Libheif" Version="1.19.5-preview1" />
		<PackageReference Include="Markdig" Version="1.3.2" />
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.123">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.0" />
		<PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="System.Management" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LivePhotoBox.Core\LivePhotoBox.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Page Update="Controls\LightboxPreview.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
		<Page Update="Controls\PageStatusBar.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	</ItemGroup>

	<ItemGroup>
		<Page Update="Views\MergePage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
		<Page Update="Views\HomePage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
		<Page Update="Views\AboutPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
		<Page Update="Views\RepairPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
		<Page Update="Views\SplitPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
		<Page Update="Views\SettingsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</Page>
	        <Page Update="Views\HistoryPage.xaml">
				<Generator>MSBuild:Compile</Generator>
			</Page>
	        <Page Update="Views\KeyPhotoPage.xaml">
				<Generator>MSBuild:Compile</Generator>
			</Page>
	        <Page Update="Views/SettingsPageModern.xaml">
					<Generator>MSBuild:Compile</Generator>
				</Page>

	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Controls\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Strings\en-US\Resources.resw" />
		<EmbeddedResource Include="Strings\zh-Hans\Resources.resw" />
	</ItemGroup>
	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<PropertyGroup>
		<PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
       <PublishReadyToRun Condition="'$(Configuration)' != 'Debug' and '$(SelfContained)' == 'true'">False</PublishReadyToRun>
		<PublishReadyToRun Condition="'$(Configuration)' != 'Debug' and '$(SelfContained)' != 'true'">False</PublishReadyToRun>
		<PublishTrimmed>False</PublishTrimmed>
		<!-- 跳过符号包生成，避免 mspdbcmf.exe 路径问题（GitHub Release 不需要 .appxsym） -->
		<AppxPackageGenerateSymbolsPackage>false</AppxPackageGenerateSymbolsPackage>
     <GenerateTemporaryStoreCertificate Condition="Exists('$(MSBuildProjectDirectory)\LivePhotoBox_TemporaryKey.pfx')">True</GenerateTemporaryStoreCertificate>
		<GenerateTemporaryStoreCertificate Condition="!Exists('$(MSBuildProjectDirectory)\LivePhotoBox_TemporaryKey.pfx')">False</GenerateTemporaryStoreCertificate>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
     <AppxPackageSigningEnabled Condition="Exists('$(MSBuildProjectDirectory)\LivePhotoBox_TemporaryKey.pfx')">True</AppxPackageSigningEnabled>
		<AppxPackageSigningEnabled Condition="!Exists('$(MSBuildProjectDirectory)\LivePhotoBox_TemporaryKey.pfx')">False</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
		<AppxBundlePlatforms>$(Platform)</AppxBundlePlatforms>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
        <PackageCertificateKeyFile Condition="Exists('$(MSBuildProjectDirectory)\LivePhotoBox_TemporaryKey.pfx')">LivePhotoBox_TemporaryKey.pfx</PackageCertificateKeyFile>
		<AppInstallerUri>https://github.com/LengxiQwQ/live-photo-box</AppInstallerUri>
		<GenerateTestArtifacts>False</GenerateTestArtifacts>
	</PropertyGroup>

	<!-- 编译时从 Package.appxmanifest 自动同步版本号到程序集，确保单一版本来源 -->
	<Target Name="SyncVersionFromManifest" BeforeTargets="BeforeBuild">
		<XmlPeek XmlInputPath="Package.appxmanifest" Query="/x:Package/x:Identity/@Version" Namespaces="&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
			<Output TaskParameter="Result" PropertyName="_ManifestVersion" />
		</XmlPeek>
		<PropertyGroup Condition="$(_ManifestVersion) != ''">
			<Version>$(_ManifestVersion)</Version>
			<FileVersion>$(_ManifestVersion)</FileVersion>
		</PropertyGroup>
		<Message Importance="high" Text="Version synced from Package.appxmanifest: $(_ManifestVersion)" Condition="$(_ManifestVersion) != ''" />
	</Target>

	<!-- Strip unwanted WinUI/WinAppSDK locale satellite folders from output (keep only zh-Hans / en-US) -->
	<!-- dotnet publish 不会自动复制 XAML 编译输出 (.xbf/.pri)，手动补上 -->
		<Target Name="CopyXamlOutputsOnPublish" AfterTargets="Publish">
			<ItemGroup>
				<_XamlOutputs Include="$(OutDir)*.xbf" />
				<_XamlOutputs Include="$(OutDir)*.pri" />
				<!-- appsettings.json 是运行时生成，不随构建发布 -->
				<_XamlDirs Include="$(OutDir)Controls\**\*" />
				<_XamlDirs Include="$(OutDir)Views\**\*" />
			</ItemGroup>
			<Copy SourceFiles="@(_XamlOutputs)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
			<Copy SourceFiles="@(_XamlDirs)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
		</Target>

		<Target Name="StripUnwantedLocales" AfterTargets="Build" Condition="Exists('$(OutDir)')">
		<Exec Command="powershell -NoProfile -NoLogo -Command &quot;Get-ChildItem '$(OutDir)' -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^[a-z]{2,3}(-[A-Za-z0-9]+)+$' -and $_.Name -notin @('en-US','en-us','zh-Hans','zh-CN') } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue&quot;" IgnoreExitCode="true" />
	</Target>

		<ItemGroup>
		  <PRIResource Remove="Tools\**" />
		</ItemGroup>
</Project>