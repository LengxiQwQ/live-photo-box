<Window
    x:Class="LivePhotoBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LivePhotoBox.Controls"
    Title="Live Photo Box">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="8">
                <Image Source="/Assets/AppIcon-2D-Translucence.png" Width="16" Height="16" Stretch="Uniform" />
                <TextBlock x:Uid="MainWindow_Title" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1" x:Name="NavView" 
                        PaneDisplayMode="Left" 
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        OpenPaneLength="200" 
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Home" Tag="Home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Merge" Tag="Merge">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Uid="Nav_Split" Tag="Split">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C6;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Repair" Tag="Repair">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHistory" x:Uid="Nav_History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_KeyPhoto" Tag="KeyPhoto">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDAB;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_PhotoClassify" Tag="PhotoClassify">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED43;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="About" x:Uid="Nav_About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="MainFrame" Padding="0" Background="Transparent"/>

                <controls:PageStatusBar x:Name="PageStatusBar"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Bottom" />

                <!-- 全屏灯箱：覆盖内容区 + 状态栏，不挡左侧菜单和标题栏 -->
                <controls:LightboxPreview x:Name="LightboxPreview"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>