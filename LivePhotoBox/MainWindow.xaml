<!-- MainWindow.xaml — 主窗口布局：标题栏 + NavigationView侧边导航 + 内容区 + 状态栏 + 灯箱 -->
<Window
    x:Class="LivePhotoBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LivePhotoBox.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="8">
                <Image Source="/Assets/Icons/AppIcon-2D-Translucence.png" Width="16" Height="16" Stretch="Uniform" />
                <TextBlock x:Name="TitleBarText" x:Uid="MainWindow_Title" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- 侧边导航栏 -->
        <NavigationView Grid.Row="1" x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        OpenPaneLength="200"
                        PaneOpened="NavView_PaneOpened"
                        PaneClosed="NavView_PaneClosed"
                        SelectionChanged="NavView_SelectionChanged">

            <!-- 主导航菜单 -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Home" Tag="Home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_KeyPhoto" Tag="Edit">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE932;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Merge" Tag="Merge">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Split" Tag="Split">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C6;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Repair" Tag="Repair">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHistory" x:Uid="Nav_History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_PhotoClassify" Tag="PhotoClassify">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED43;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 底部页脚菜单 -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="About" x:Uid="Nav_About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 覆盖 NavigationView 默认资源：透明背景 + 零边距 + 去分隔线，让底层材质透出 -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
            </NavigationView.Resources>

            <!-- 内容区：Frame 加载页面 + 状态栏 + 全屏灯箱 -->
            <Grid>
                <Frame x:Name="MainFrame" Padding="0" Background="Transparent"/>
                <controls:PageStatusBar x:Name="PageStatusBar"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Bottom" />
                <!-- 全屏灯箱：覆盖内容区+状态栏，不遮导航和标题栏 -->
                <controls:LightboxPreview x:Name="LightboxPreview"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
