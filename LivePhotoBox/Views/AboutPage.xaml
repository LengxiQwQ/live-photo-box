<!--
 * AboutPage.xaml
 *
 * 关于页面 — 展示应用信息、功能特性、开发者和开源致谢。
 *
 * 设计原则：
 *   - 与首页和设置页保持一致的视觉节奏（透明背景、亚克力卡片、圆角 12px）
 *   - 卡片统一使用 CustomPanelAcrylicBrush + DividerStrokeColorDefaultBrush
 *   - 区块标题带图标 + SemiBold 文字
 -->
<Page
    x:Class="LivePhotoBox.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d" Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="40,24,40,0">
        <StackPanel Spacing="24" MaxWidth="1400" HorizontalAlignment="Stretch" Margin="0,0,0,40">

            <!-- ═══════════════ 首屏介绍 ═══════════════ -->
            <Border CornerRadius="12" Background="{ThemeResource CustomPanelAcrylicBrush}"
                    Padding="40" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Source="ms-appx:///Assets/Icons/AppIcon-Store-300.png"
                           Width="210" Height="210"
                           VerticalAlignment="Center" Margin="0,0,40,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                        <TextBlock x:Uid="AboutPage_Title"
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   FontWeight="Bold" FontFamily="Microsoft YaHei UI"
                                   FontSize="26"/>

                        <Button Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Left" Padding="0"
                                Command="{x:Bind ViewModel.OpenLinkCommand}"
                                CommandParameter="https://github.com/LengxiQwQ/live-photo-box/releases">
                            <TextBlock FontSize="15" FontFamily="Microsoft YaHei UI"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run x:Uid="AboutPage_VersionLabel"/>
                                <Run Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" · "/>
                                <Run Text="{x:Bind ViewModel.AppDistribution, Mode=OneWay}"/>
                            </TextBlock>
                        </Button>

                        <TextBlock x:Uid="AboutPage_Description"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14" LineHeight="22" TextWrapping="Wrap"
                                   FontFamily="Microsoft YaHei UI"/>

                        <toolkit:WrapPanel HorizontalSpacing="12" VerticalSpacing="12" Margin="0,16,0,0">
                            <Button x:Uid="AboutPage_GitHubButton"
                                    Command="{x:Bind ViewModel.OpenLinkCommand}"
                                    CommandParameter="https://github.com/LengxiQwQ/live-photo-box">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Width="16" Height="16" VerticalAlignment="Center">
                                                <Image.Source>
                                                    <SvgImageSource UriSource="ms-appx:///Assets/Icons/Social/github-black.svg"/>
                                                </Image.Source>
                                            </Image>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Uid="AboutPage_StoreButton"
                                    Command="{x:Bind ViewModel.OpenLinkCommand}"
                                    CommandParameter="ms-windows-store://pdp/?ProductId=9N3D1QNRTVCH">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Image Width="16" Height="16" VerticalAlignment="Center">
                                                <Image.Source>
                                                    <SvgImageSource UriSource="ms-appx:///Assets/Icons/Social/store-microsoft.svg"/>
                                                </Image.Source>
                                            </Image>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Uid="AboutPage_CheckUpdateButton"
                                    Click="CheckUpdate_Click">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE895;" FontSize="14"/>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Uid="AboutPage_ChangelogButton"
                                    Command="{x:Bind ViewModel.ShowChangelogCommand}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE823;" FontSize="14"/>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Uid="AboutPage_OpenInstallFolderButton"
                                    Click="OpenInstallFolder_Click">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:SymbolIcon Symbol="FolderOpen" FontSize="14"/>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Uid="AboutPage_CliManualButton"
                                    Command="{x:Bind ViewModel.ShowCliManualCommand}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE756;" FontSize="14"/>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Uid="AboutPage_IssueButton"
                                    Command="{x:Bind ViewModel.OpenLinkCommand}"
                                    CommandParameter="https://github.com/LengxiQwQ/live-photo-box/issues">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xED15;" FontSize="14"/>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Uid="AboutPage_RateButton"
                                    Command="{x:Bind ViewModel.OpenLinkCommand}"
                                    CommandParameter="ms-windows-store://review/?ProductId=9N3D1QNRTVCH">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:SymbolIcon Symbol="StarEmphasis" FontSize="16"/>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </toolkit:WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ 功能特性 ═══════════════ -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,0,0,0">
                    <FontIcon Glyph="&#xECA5;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="AboutPage_FeaturesTitle" FontSize="20" FontWeight="SemiBold"
                               FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="16" RowSpacing="16">
                    <!-- 1. 编辑 -->
                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="24">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Glyph="&#xE932;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_FeatureEditTitle" FontWeight="SemiBold"
                                           FontSize="15" FontFamily="Microsoft YaHei UI" Margin="0,0,0,4"/>
                                <TextBlock x:Uid="AboutPage_FeatureEditDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" FontSize="13" FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. 合成 -->
                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="24">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Glyph="&#xE8B1;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_FeatureMergeTitle" FontWeight="SemiBold"
                                           FontSize="15" FontFamily="Microsoft YaHei UI" Margin="0,0,0,4"/>
                                <TextBlock x:Uid="AboutPage_FeatureMergeDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" FontSize="13" FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. 拆分 -->
                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="24">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Glyph="&#xE8C6;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_FeatureSplitTitle" FontWeight="SemiBold"
                                           FontSize="15" FontFamily="Microsoft YaHei UI" Margin="0,0,0,4"/>
                                <TextBlock x:Uid="AboutPage_FeatureSplitDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" FontSize="13" FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4. 修复 -->
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="24">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon Glyph="&#xE7C5;" FontSize="28"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_FeatureRepairTitle" FontWeight="SemiBold"
                                           FontSize="15" FontFamily="Microsoft YaHei UI" Margin="0,0,0,4"/>
                                <TextBlock x:Uid="AboutPage_FeatureRepairDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" FontSize="13" FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ═══════════════ 开发者 ═══════════════ -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,0,0,0">
                    <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="AboutPage_DeveloperTitle" FontSize="20" FontWeight="SemiBold"
                               FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
                </StackPanel>
                <Border CornerRadius="12" Background="{ThemeResource CustomPanelAcrylicBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="28">
                    <StackPanel Spacing="16">
                        <!-- Avatar + Name (clickable → GitHub) + Bio -->
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- 头像外圈：描边圈比头像大 4px，图片与外圈之间留 1px 空白间隔，图片不碰圈
                                 PersonPicture 保持原渲染尺寸，避免头像被裁切/放大 -->
                            <Grid Width="82" Height="82" Margin="0,0,22,0">
                                <PersonPicture DisplayName="LengxiQwQ" Width="80" Height="80"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ProfilePicture="{x:Bind ViewModel.AvatarSource, Mode=OneWay}"/>
                                <Border CornerRadius="42" IsHitTestVisible="False"
                                        BorderBrush="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                                        BorderThickness="1"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <Button Command="{x:Bind ViewModel.OpenLinkCommand}"
                                        CommandParameter="https://github.com/LengxiQwQ"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Uid="AboutPage_DeveloperName" FontSize="18" FontWeight="Bold"
                                               FontFamily="Microsoft YaHei UI"/>
                                </Button>
                                <TextBlock x:Uid="AboutPage_DeveloperBio"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="14" FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                        </Grid>

                        <!-- Social Links -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                            <!-- Website (placeholder) -->
                            <Button CornerRadius="6" Padding="10,6" MinWidth="0" MinHeight="0"
                                    IsEnabled="False"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="AboutPage_DevWebsite_ToolTip"/>
                                </ToolTipService.ToolTip>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Globe" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="AboutPage_DevWebsite" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- GitHub -->
                            <Button Command="{x:Bind ViewModel.OpenLinkCommand}"
                                    CommandParameter="https://github.com/LengxiQwQ"
                                    CornerRadius="6" Padding="10,6" MinWidth="0" MinHeight="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="17" Height="17" VerticalAlignment="Center"
                                           Margin="-2,0,0,0">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/Social/github.svg"/>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="GitHub" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- bilibili -->
                            <Button Command="{x:Bind ViewModel.OpenLinkCommand}"
                                    CommandParameter="https://space.bilibili.com/477811145"
                                    CornerRadius="6" Padding="10,6" MinWidth="0" MinHeight="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="16" Height="16" VerticalAlignment="Center">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/Social/bilibili.svg"/>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="bilibili" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- YouTube -->
                            <Button Command="{x:Bind ViewModel.OpenLinkCommand}"
                                    CommandParameter="https://www.youtube.com/@lengxiya"
                                    CornerRadius="6" Padding="10,6" MinWidth="0" MinHeight="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Width="16" Height="16" VerticalAlignment="Center">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/Social/youtube.svg"/>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="YouTube" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18">
                            <!-- 联系作者 -->
                            <Button Background="Transparent" BorderThickness="0" Padding="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE715;" FontSize="15" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Uid="AboutPage_ContactAuthor" FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel Spacing="16" Padding="16" MaxWidth="400">
                                            <!-- 邮箱 -->
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Uid="AboutPage_ContactEmail"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="lengxiowo@gmail.com" FontSize="15"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               IsTextSelectionEnabled="True"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" x:Name="CopyEmailButton" Click="OnCopyEmailClick"
                                                            VerticalAlignment="Center" Margin="12,0,0,0"
                                                            Style="{ThemeResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                                            <TextBlock x:Uid="AboutPage_CopyEmail"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <!-- QQ -->
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Uid="AboutPage_ContactQQ"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="3197635836" FontSize="15"
                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                               IsTextSelectionEnabled="True"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" x:Name="CopyQQButton" Click="OnCopyQQClick"
                                                            VerticalAlignment="Center" Margin="12,0,0,0"
                                                            Style="{ThemeResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                                            <TextBlock x:Uid="AboutPage_CopyQQ"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 复制成功反馈 -->
                                            <TextBlock x:Name="CopiedFeedback"
                                                       x:Uid="AboutPage_EmailCopied"
                                                       Foreground="{ThemeResource SystemAccentColor}"
                                                       FontSize="13" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- 赞助作者 -->
                            <Button Background="Transparent" BorderThickness="0" Padding="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEB51;" FontSize="15" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Uid="AboutPage_SponsorButton" FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <StackPanel Spacing="16" Padding="16" MaxWidth="340">
                                            <!-- 标题 -->
                                            <TextBlock x:Uid="AboutPage_Sponsor_Title" FontSize="15"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Microsoft YaHei UI"/>

                                            <!-- GitHub Sponsors -->
                                            <Button Command="{x:Bind ViewModel.OpenLinkCommand}"
                                                    CommandParameter="https://github.com/sponsors/LengxiQwQ"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{ThemeResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Image Width="16" Height="16" VerticalAlignment="Center">
                                                        <Image.Source>
                                                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/Social/github-white.svg"/>
                                                        </Image.Source>
                                                    </Image>
                                                    <TextBlock x:Uid="AboutPage_Sponsor_GitHub" Margin="0,0,0,1"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 爱发电 -->
                                            <Button Command="{x:Bind ViewModel.OpenLinkCommand}"
                                                    CommandParameter="https://afdian.com/a/lengxiqwq"
                                                    HorizontalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Image Width="16" Height="16" VerticalAlignment="Center">
                                                        <Image.Source>
                                                            <SvgImageSource UriSource="ms-appx:///Assets/Icons/Social/afdian.svg"/>
                                                        </Image.Source>
                                                    </Image>
                                                    <TextBlock x:Uid="AboutPage_Sponsor_Afdian" Margin="0,0,0,1"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 微信赞赏码 -->
                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                <TextBlock x:Uid="AboutPage_Sponsor_WeChat" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="Microsoft YaHei UI"/>
                                                <Border CornerRadius="8" Padding="4"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Image Width="200" Height="200" Stretch="Uniform">
                                                        <Image.Source>
                                                            <BitmapImage UriSource="ms-appx:///Assets/Sponsor/wechat-sponsor.jpg"/>
                                                        </Image.Source>
                                                    </Image>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════════ 开源致谢 ═══════════════ -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,0,0,0">
                    <FontIcon Glyph="&#xEB51;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="AboutPage_OpenSourceTitle" FontSize="20" FontWeight="SemiBold"
                               FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="12">
                    <!-- FFmpeg (Row 0 Col 0) — 视频转码核心 -->
                    <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://ffmpeg.org/">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/ffmpeg.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditFFmpegName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditFFmpegDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- ExifTool (Row 0 Col 1) — 元数据处理核心 -->
                    <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://exiftool.org/">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/exiftool.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditExifToolName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditExifToolDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- libheif (Row 0 Col 2) — HEIC 编解码管线 -->
                    <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://github.com/strukturag/libheif">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/libheif.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditLibheifName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditLibheifDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- JPEGTran (Row 1 Col 0) — 无损 JPEG 处理 -->
                    <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="http://jpegclub.org/jpegtran/">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/jpegtran.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditJPEGTranName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditJPEGTranDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- Magick.NET (Row 1 Col 1) — HEIC 图像解码 -->
                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://github.com/dlemstra/Magick.NET">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/magicknet.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditMagickNETName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditMagickNETDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- CommunityToolkit (Row 1 Col 2) — MVVM 框架 + UI 控件 -->
                    <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://github.com/CommunityToolkit/dotnet">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/communitytoolkit.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditCommunityToolkitName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditCommunityToolkitDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- MagicScaler (Row 2 Col 0) — 高性能图片缩放 -->
                    <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://github.com/saucecontrol/PhotoSauce">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/magicscaler.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditMagicScalerName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditMagicScalerDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- Markdig (Row 2 Col 1) — Markdown 渲染 -->
                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://github.com/xoofx/markdig">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/markdig.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditMarkdigName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditMarkdigDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>

                    <!-- FluentIcons (Row 2 Col 2) — Fluent Design 图标库 -->
                    <Button Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            CornerRadius="12"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="16"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://github.com/davidxuang/FluentIcons">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="40" Height="40" RadiusX="8" RadiusY="8" Margin="0,0,16,0">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/Assets/Credits/fluenticons.png"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="AboutPage_CreditFluentIconsName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                                <TextBlock x:Uid="AboutPage_CreditFluentIconsDesc"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ═══════════════ 法律信息 ═══════════════ -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,0,0,0">
                    <FontIcon Glyph="&#xE8D7;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="AboutPage_LegalTitle" FontSize="20" FontWeight="SemiBold"
                               FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- 隐私政策 -->
                    <Border CornerRadius="12" Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE72E;" FontSize="16"
                                          Foreground="{ThemeResource SystemAccentColor}"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Uid="AboutPage_PrivacyTitle"
                                           FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Uid="AboutPage_Privacy_Local" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="Microsoft YaHei UI" LineHeight="22"/>
                            <TextBlock x:Uid="AboutPage_Privacy_NoCollect" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="Microsoft YaHei UI" LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- 免责声明 -->
                    <Border CornerRadius="12" Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE946;" FontSize="16"
                                          Foreground="{ThemeResource SystemAccentColor}"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Uid="AboutPage_DisclaimerHeader"
                                           FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Uid="AboutPage_DisclaimerBody" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="Microsoft YaHei UI" LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- 许可证（整个卡片可点击，打开 GitHub 上的 LICENSE 文件） -->
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            CornerRadius="12" Padding="20"
                            Background="{ThemeResource CustomPanelAcrylicBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://github.com/LengxiQwQ/live-photo-box/blob/master/LICENSE">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ic:SymbolIcon Symbol="Scales" FontSize="16"
                                                  Foreground="{ThemeResource SystemAccentColor}"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock x:Uid="AboutPage_LicenseTitle"
                                               FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Uid="AboutPage_LicenseDesc" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="Microsoft YaHei UI" LineHeight="22"/>
                            </StackPanel>
                            <FontIcon Grid.Column="1" Glyph="&#xE8A7;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- ═══════════════ Footer ═══════════════ -->
            <TextBlock x:Uid="SettingsPage_Footer"
                       FontSize="12" Opacity="0.3"
                       HorizontalAlignment="Center"
                       Margin="0,38,0,20"/>

        </StackPanel>
    </ScrollViewer>
</Page>
