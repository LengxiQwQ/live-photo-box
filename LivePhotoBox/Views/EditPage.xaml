<Page
    x:Class="LivePhotoBox.Views.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LivePhotoBox.Models"
    xmlns:converters="using:LivePhotoBox.Converters"
    xmlns:controls="using:LivePhotoBox.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:VisibilityConverter x:Key="VisibilityConverter"/>
        <Style x:Key="EditorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="ToolSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="SecondaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- Timeline layer B: compact evidence-backed cover markers + independent frame number. -->
        <DataTemplate x:Key="TimelineMarkerTemplate" x:DataType="models:EditTimelinePresentationItem">
            <Grid Width="72" Height="48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="17"/>
                    <RowDefinition Height="17"/>
                    <RowDefinition Height="14"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Width="72" Height="17"
                      Visibility="{x:Bind IsCurrentCoverMarker, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                    <Border Height="13" Padding="5,0" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="#FFF2C744">
                        <TextBlock x:Uid="EditPage_Visual_CurrentCoverMarker" FontSize="8" FontWeight="SemiBold"
                                   Foreground="#FF322800" VerticalAlignment="Center"/>
                    </Border>
                    <Polygon Points="0,0 8,0 4,4" Fill="#FFF2C744"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                </Grid>
                <Grid Grid.Row="1" Width="72" Height="17"
                      Visibility="{x:Bind IsOriginalCoverMarker, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                    <Border Height="13" Padding="5,0" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Background="#FFA76CF5">
                        <TextBlock x:Uid="EditPage_Visual_OriginalCoverMarker" FontSize="8" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                    <Polygon Points="0,0 8,0 4,4" Fill="#FFA76CF5"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="{x:Bind DisplayNumber}" FontSize="10"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            </Grid>
        </DataTemplate>

        <!-- Timeline layer C: every real video frame is a strict 1:1 square. -->
        <DataTemplate x:Key="TimelineThumbnailTemplate" x:DataType="models:EditTimelinePresentationItem">
            <Border Width="72" Height="72" CornerRadius="6"
                    Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Tapped="TimelineThumbnail_Tapped">
                <Grid>
                    <FontIcon Glyph="&#xE722;" FontSize="18"
                              Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                    <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3"
                            CornerRadius="6" IsHitTestVisible="False"
                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="16,12,16,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition x:Name="TimelineRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderBar" Grid.Row="0" MinHeight="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock x:Uid="EditPage_PageTitle" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.ExportProgressText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Uid="EditPage_Visual_Undo" IsEnabled="False"/>
                <Button x:Uid="EditPage_Visual_Redo" IsEnabled="False"/>
                <Border Width="1" Height="20" Margin="4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Button x:Name="ExportFramesButton" x:Uid="EditPage_Visual_ExportFrames"
                        IsEnabled="{x:Bind ViewModel.IsSelectedLivePhoto, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="EditPage_Visual_ExportCurrentFrame" Command="{x:Bind ViewModel.ExportCurrentFrameCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanExportCurrentFrame, Mode=OneWay}"/>
                            <MenuFlyoutItem x:Uid="EditPage_Visual_ExportAllFrames" Command="{x:Bind ViewModel.ExportAllFramesCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanExportMultiFrame, Mode=OneWay}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Uid="EditPage_Visual_SaveCopy" Command="{x:Bind ViewModel.SaveCommand}"
                        IsEnabled="{x:Bind ViewModel.IsSetKeyPhotoEnabled, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <!-- Upper editor: Preview left, Edit Tools right -->
        <Grid x:Name="EditorTopGrid" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="ToolsColumn" Width="340" MinWidth="300" MaxWidth="380"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewBorder" Style="{StaticResource EditorCardStyle}">
                <Grid>
                    <controls:PhotoViewer x:Name="PhotoViewer"
                                          ImageSource="{x:Bind ViewModel.PreviewImageSource, Mode=OneWay}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <controls:PureMediaViewer x:Name="PureMediaViewer" Visibility="Collapsed"
                                              ShowTransportControls="False" ShowCloseButton="False"
                                              AutoCloseOnEnd="False" CloseRequested="PureMediaViewer_CloseRequested"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <StackPanel x:Name="ZoomControlsPanel" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Visibility="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                        <Button x:Uid="EditPage_Visual_ZoomOut" Width="32" Height="30" Padding="0" Click="ZoomOutButton_Click">
                            <FontIcon Glyph="&#xE949;" FontSize="12"/>
                        </Button>
                        <Button x:Name="ZoomPercentButton" Width="48" Height="30" Padding="0"
                                Click="ZoomPercentButton_Click" x:Uid="EditPage_Visual_ZoomReset">
                            <TextBlock x:Name="ZoomPercentText" Text="100%" FontSize="10" FontWeight="SemiBold"/>
                        </Button>
                        <Button x:Uid="EditPage_Visual_ZoomIn" Width="32" Height="30" Padding="0" Click="ZoomInButton_Click">
                            <FontIcon Glyph="&#xE948;" FontSize="12"/>
                        </Button>
                        <Border Width="1" Height="18" Margin="3,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Button x:Name="MaximizeButton" x:Uid="EditPage_Visual_Maximize" Width="32" Height="30" Padding="0"
                                Click="MaximizeButton_Click">
                            <FontIcon x:Name="MaximizeButtonIcon" Glyph="&#xE740;" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PreviewEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE91B;" FontSize="38" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="PreviewEmptyText" x:Uid="EditPage_Visual_EmptyPrompt" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <Button x:Name="OpenLivePhotoButton" x:Uid="EditPage_Visual_OpenFile"
                                HorizontalAlignment="Center" Click="OpenLivePhotoButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="EditToolsBorder" Grid.Column="1" Style="{StaticResource EditorCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16" Spacing="18">
                        <TextBlock x:Uid="EditPage_Visual_EditTools" FontSize="16" FontWeight="SemiBold"/>

                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="EditPage_Visual_CoverSection" Style="{StaticResource ToolSectionTitleStyle}"/>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="EditPage_Visual_CurrentCover" FontWeight="SemiBold" FontSize="12"/>
                                <Border Height="150" CornerRadius="6" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                                    <Image Source="{x:Bind ViewModel.CurrentCoverThumbnail, Mode=OneWay}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Uid="EditPage_Visual_IndependentStill" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentCoverAssociationText, Mode=OneWay}"
                                           Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap"/>
                                <Button x:Uid="EditPage_Visual_UseCurrentFrameCover" HorizontalAlignment="Stretch"
                                        Click="UseCurrentFrameAsCover_Click"
                                        IsEnabled="{x:Bind ViewModel.HasTimelineFrames, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="EditPage_Visual_OriginalCover" FontWeight="SemiBold" FontSize="12"/>
                                <Border Height="150" CornerRadius="6" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                                    <Image Source="{x:Bind ViewModel.OriginalCoverThumbnail, Mode=OneWay}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Uid="EditPage_Visual_IndependentStill" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.OriginalCoverAssociationText, Mode=OneWay}"
                                           Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="EditPage_Visual_PlaybackRange" Style="{StaticResource ToolSectionTitleStyle}"/>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Uid="EditPage_Visual_StartTime" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PlaybackRangeStartText, Mode=OneWay}"/>
                                <TextBlock Grid.Row="1" x:Uid="EditPage_Visual_EndTime" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PlaybackRangeEndText, Mode=OneWay}"/>
                                <TextBlock Grid.Row="2" x:Uid="EditPage_Visual_Duration" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.PlaybackRangeSummaryText, Mode=OneWay}"/>
                                <Button Grid.Row="3" Grid.Column="1" x:Uid="EditPage_Visual_Reset" Click="ResetPlaybackRange_Click"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Expander x:Uid="EditPage_Visual_ReplaceMotionVideo">
                            <StackPanel Spacing="8" Padding="0,8,0,4">
                                <Button x:Uid="EditPage_Visual_SelectVideo" IsEnabled="False" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                        <Expander x:Uid="EditPage_Visual_ReplaceStillImage">
                            <StackPanel Spacing="8" Padding="0,8,0,4">
                                <Button x:Uid="EditPage_Visual_SelectImage" IsEnabled="False" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Full-width Timeline, exactly A/B/C/D visual layers -->
        <Border x:Name="TimelinePanel" Grid.Row="2" Style="{StaticResource EditorCardStyle}" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- A. Header -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton x:Name="FilmstripModeButton" x:Uid="EditPage_Visual_FilmstripMode"
                                      IsChecked="{x:Bind ViewModel.IsFilmstripPresentationMode, Mode=OneWay}"
                                      Click="FilmstripModeButton_Click"/>
                        <ToggleButton x:Name="ClassicModeButton" x:Uid="EditPage_Visual_ClassicMode"
                                      IsChecked="{x:Bind ViewModel.IsClassicPresentationMode, Mode=OneWay}"
                                      Click="ClassicModeButton_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TimelinePositionText, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                        <Button Width="32" Height="30" Padding="0" Click="PreviousFrameButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasTimelineFrames, Mode=OneWay}" x:Uid="EditPage_Visual_PreviousFrame">
                            <FontIcon Glyph="&#xE892;" FontSize="12"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Width="34" Height="30" Padding="0" Click="PlayPauseButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanPlayLivePhoto, Mode=OneWay}" x:Uid="EditPage_Visual_PlayPause">
                            <FontIcon x:Name="PlaybackIcon" Glyph="&#xE768;" FontSize="12"/>
                        </Button>
                        <Button Width="32" Height="30" Padding="0" Click="NextFrameButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasTimelineFrames, Mode=OneWay}" x:Uid="EditPage_Visual_NextFrame">
                            <FontIcon Glyph="&#xE893;" FontSize="12"/>
                        </Button>
                        <Button Width="34" Height="30" Padding="0" Click="MuteButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanPlayLivePhoto, Mode=OneWay}" x:Uid="EditPage_Visual_Mute">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="⚠" FontSize="15" VerticalAlignment="Center"
                               x:Uid="EditPage_Visual_ReencodeWarning"
                               Visibility="{x:Bind ViewModel.IsReencodeWarningVisible, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                        <Button x:Uid="EditPage_Visual_DeleteFrame" IsEnabled="False"/>
                        <Button x:Uid="EditPage_Visual_AddFrame" IsEnabled="False"/>
                        <Button x:Uid="EditPage_Visual_More" Content="⋯" Width="34" IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- Filmstrip: B and C share one viewport so numbers/markers stay aligned with thumbnails. -->
                <ScrollViewer x:Name="FilmstripScrollViewer" Grid.Row="1" Grid.RowSpan="2"
                              Visibility="{x:Bind ViewModel.IsFilmstripPresentationMode, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled"
                              ViewChanged="TimelineScrollViewer_ViewChanged" SizeChanged="TimelineViewport_SizeChanged">
                    <StackPanel Spacing="4">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.VideoTimelineFrames, Mode=OneWay}"
                                       ItemTemplate="{StaticResource TimelineMarkerTemplate}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.VideoTimelineFrames, Mode=OneWay}"
                                       ItemTemplate="{StaticResource TimelineThumbnailTemplate}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

                <!-- Classic: current-master center/snap interaction semantics, rehosted over real video frames only. -->
                <Grid x:Name="ClassicTimelineRoot" Grid.Row="1" Grid.RowSpan="2" Height="118"
                      Visibility="{x:Bind ViewModel.IsClassicPresentationMode, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                    <ScrollViewer x:Name="ClassicTimelineScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled"
                                  ViewChanged="ClassicTimelineScrollViewer_ViewChanged"
                                  SizeChanged="ClassicTimelineScrollViewer_SizeChanged">
                        <Border x:Name="ClassicTimelinePaddingBorder" Padding="0">
                            <StackPanel Spacing="4">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.VideoTimelineFrames, Mode=OneWay}"
                                               ItemTemplate="{StaticResource TimelineMarkerTemplate}">
                                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.VideoTimelineFrames, Mode=OneWay}"
                                               ItemTemplate="{StaticResource TimelineThumbnailTemplate}">
                                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    <Border Width="76" Height="76" CornerRadius="7" BorderThickness="3"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                </Grid>

                <!-- D. Overview Bar: same full width as the frame viewport, never a playback seek bar. -->
                <Border x:Name="TimelineOverviewTrack" Grid.Row="3" Height="16" CornerRadius="8"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        SizeChanged="TimelineOverviewTrack_SizeChanged"
                        PointerPressed="TimelineOverviewTrack_PointerPressed"
                        PointerMoved="TimelineOverviewTrack_PointerMoved"
                        PointerReleased="TimelineOverviewTrack_PointerReleased"
                        PointerCaptureLost="TimelineOverviewTrack_PointerCaptureLost">
                    <Canvas x:Name="TimelineOverviewCanvas" Height="16">
                        <Border x:Name="TimelineOverviewViewport" Height="10" CornerRadius="5"
                                Background="{ThemeResource ControlFillColorTertiaryBrush}" Canvas.Top="3"/>
                        <Border x:Name="TimelineOverviewPosition" Width="3" Height="12" CornerRadius="2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" Canvas.Top="2"/>
                    </Canvas>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
