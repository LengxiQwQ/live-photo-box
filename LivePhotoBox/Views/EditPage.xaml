<Page
    x:Class="LivePhotoBox.Views.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LivePhotoBox.Models"
    xmlns:converters="using:LivePhotoBox.Converters"
    xmlns:controls="using:LivePhotoBox.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:VisibilityConverter x:Key="VisibilityConverter"/>
        <Style x:Key="EditorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="ToolSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="SecondaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- Timeline layer B: cover markers + frame number. No cover consumes an item. -->
        <DataTemplate x:Key="TimelineMarkerTemplate" x:DataType="models:EditTimelinePresentationItem">
            <Grid Width="72" Height="42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="12"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="当前封面 ▼" FontSize="9" FontWeight="SemiBold"
                           Foreground="#FFF2C744" HorizontalAlignment="Center"
                           Visibility="{x:Bind IsCurrentCoverMarker, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                <TextBlock Grid.Row="1" Text="原始封面 ▼" FontSize="9" FontWeight="SemiBold"
                           Foreground="#FFA76CF5" HorizontalAlignment="Center"
                           Visibility="{x:Bind IsOriginalCoverMarker, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                <TextBlock Grid.Row="2" Text="{x:Bind DisplayNumber}" FontSize="10"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            </Grid>
        </DataTemplate>

        <!-- Timeline layer C: every real video frame is a strict 1:1 square. -->
        <DataTemplate x:Key="TimelineThumbnailTemplate" x:DataType="models:EditTimelinePresentationItem">
            <Border Width="72" Height="72" CornerRadius="6"
                    Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Tapped="TimelineThumbnail_Tapped">
                <Grid>
                    <FontIcon Glyph="&#xE722;" FontSize="18"
                              Visibility="{x:Bind ThumbnailPlaceholderVisibility, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                    <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3"
                            CornerRadius="6" IsHitTestVisible="False"
                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="16,12,16,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition x:Name="TimelineRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderBar" Grid.Row="0" MinHeight="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="实况照片编辑" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.ExportProgressText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="撤销" IsEnabled="False" ToolTipService.ToolTip="本轮仅保留 UI 入口"/>
                <Button Content="重做" IsEnabled="False" ToolTipService.ToolTip="本轮仅保留 UI 入口"/>
                <Border Width="1" Height="20" Margin="4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Button x:Name="ExportFramesButton" Content="导出帧..."
                        IsEnabled="{x:Bind ViewModel.IsSelectedLivePhoto, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="导出当前帧" Command="{x:Bind ViewModel.ExportCurrentFrameCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanExportCurrentFrame, Mode=OneWay}"/>
                            <MenuFlyoutItem Text="导出所有帧" Command="{x:Bind ViewModel.ExportAllFramesCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanExportMultiFrame, Mode=OneWay}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="保存副本" Command="{x:Bind ViewModel.SaveCommand}"
                        IsEnabled="{x:Bind ViewModel.IsSetKeyPhotoEnabled, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <!-- Upper editor: Preview left, Edit Tools right -->
        <Grid x:Name="EditorTopGrid" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="ToolsColumn" Width="340" MinWidth="300" MaxWidth="380"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewBorder" Style="{StaticResource EditorCardStyle}">
                <Grid>
                    <controls:PhotoViewer x:Name="PhotoViewer"
                                          ImageSource="{x:Bind ViewModel.PreviewImageSource, Mode=OneWay}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <controls:PureMediaViewer x:Name="PureMediaViewer" Visibility="Collapsed"
                                              ShowTransportControls="False" ShowCloseButton="False"
                                              AutoCloseOnEnd="False" CloseRequested="PureMediaViewer_CloseRequested"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <StackPanel x:Name="ZoomControlsPanel" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Visibility="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                        <Button Width="32" Height="30" Padding="0" Click="ZoomOutButton_Click" ToolTipService.ToolTip="缩小">
                            <FontIcon Glyph="&#xE949;" FontSize="12"/>
                        </Button>
                        <Button x:Name="ZoomPercentButton" Width="48" Height="30" Padding="0"
                                Click="ZoomPercentButton_Click" ToolTipService.ToolTip="100% / 适应窗口">
                            <TextBlock x:Name="ZoomPercentText" Text="100%" FontSize="10" FontWeight="SemiBold"/>
                        </Button>
                        <Button Width="32" Height="30" Padding="0" Click="ZoomInButton_Click" ToolTipService.ToolTip="放大">
                            <FontIcon Glyph="&#xE948;" FontSize="12"/>
                        </Button>
                        <Border Width="1" Height="18" Margin="3,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Button x:Name="MaximizeButton" Width="32" Height="30" Padding="0"
                                Click="MaximizeButton_Click" ToolTipService.ToolTip="最大化预览">
                            <FontIcon x:Name="MaximizeButtonIcon" Glyph="&#xE740;" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PreviewEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="10" IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE91B;" FontSize="38" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="PreviewEmptyText" Text="选择一个实况照片开始编辑" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="EditToolsBorder" Grid.Column="1" Style="{StaticResource EditorCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16" Spacing="18">
                        <TextBlock Text="编辑工具" FontSize="16" FontWeight="SemiBold"/>

                        <StackPanel Spacing="12">
                            <TextBlock Text="封面" Style="{StaticResource ToolSectionTitleStyle}"/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="当前封面" FontWeight="SemiBold" FontSize="12"/>
                                <Border Height="150" CornerRadius="6" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                                    <Image Source="{x:Bind ViewModel.CurrentCoverThumbnail, Mode=OneWay}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="独立静态图像" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentCoverAssociationText, Mode=OneWay}"
                                           Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap"/>
                                <Button Content="使用当前帧作为封面" HorizontalAlignment="Stretch"
                                        Click="UseCurrentFrameAsCover_Click"
                                        IsEnabled="{x:Bind ViewModel.HasTimelineFrames, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="原始封面" FontWeight="SemiBold" FontSize="12"/>
                                <Border Height="150" CornerRadius="6" Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}">
                                    <Image Source="{x:Bind ViewModel.OriginalCoverThumbnail, Mode=OneWay}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="独立静态图像" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.OriginalCoverAssociationText, Mode=OneWay}"
                                           Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <StackPanel Spacing="10">
                            <TextBlock Text="播放范围" Style="{StaticResource ToolSectionTitleStyle}"/>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="开始时间" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PlaybackRangeStartText, Mode=OneWay}"/>
                                <TextBlock Grid.Row="1" Text="结束时间" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PlaybackRangeEndText, Mode=OneWay}"/>
                                <TextBlock Grid.Row="2" Text="持续时间" Style="{StaticResource SecondaryLabelStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.PlaybackRangeSummaryText, Mode=OneWay}"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="重置" Click="ResetPlaybackRange_Click"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Expander Header="替换动态视频">
                            <StackPanel Spacing="8" Padding="0,8,0,4">
                                <TextBlock Text="本轮仅提供界面入口，不执行媒体替换。" Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap"/>
                                <Button Content="选择视频..." IsEnabled="False" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="替换静态图像">
                            <StackPanel Spacing="8" Padding="0,8,0,4">
                                <TextBlock Text="本轮仅提供界面入口，不执行媒体替换。" Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap"/>
                                <Button Content="选择图像..." IsEnabled="False" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Full-width Timeline, exactly A/B/C/D visual layers -->
        <Border x:Name="TimelinePanel" Grid.Row="2" Style="{StaticResource EditorCardStyle}" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- A. Header -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton x:Name="FilmstripModeButton" Content="胶片模式"
                                      IsChecked="{x:Bind ViewModel.IsFilmstripPresentationMode, Mode=OneWay}"
                                      Click="FilmstripModeButton_Click"/>
                        <ToggleButton x:Name="ClassicModeButton" Content="经典模式"
                                      IsChecked="{x:Bind ViewModel.IsClassicPresentationMode, Mode=OneWay}"
                                      Click="ClassicModeButton_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TimelinePositionText, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                        <Button Width="32" Height="30" Padding="0" Click="PreviousFrameButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasTimelineFrames, Mode=OneWay}" ToolTipService.ToolTip="上一帧">
                            <FontIcon Glyph="&#xE892;" FontSize="12"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Width="34" Height="30" Padding="0" Click="PlayPauseButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanPlayLivePhoto, Mode=OneWay}" ToolTipService.ToolTip="播放 / 暂停">
                            <FontIcon x:Name="PlaybackIcon" Glyph="&#xE768;" FontSize="12"/>
                        </Button>
                        <Button Width="32" Height="30" Padding="0" Click="NextFrameButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasTimelineFrames, Mode=OneWay}" ToolTipService.ToolTip="下一帧">
                            <FontIcon Glyph="&#xE893;" FontSize="12"/>
                        </Button>
                        <Button Width="34" Height="30" Padding="0" Click="MuteButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanPlayLivePhoto, Mode=OneWay}" ToolTipService.ToolTip="静音">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="⚠" FontSize="15" VerticalAlignment="Center"
                               ToolTipService.ToolTip="本轮新增编辑入口仅为 UI / Presentation State；未接入帧增删、替换、裁切或重编码后端。"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                        <Button Content="删除帧" IsEnabled="False"/>
                        <Button Content="+ 添加帧" IsEnabled="False"/>
                        <Button Content="..." Width="34" IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- Filmstrip: B and C share one viewport so numbers/markers stay aligned with thumbnails. -->
                <ScrollViewer x:Name="FilmstripScrollViewer" Grid.Row="1" Grid.RowSpan="2"
                              Visibility="{x:Bind ViewModel.IsFilmstripPresentationMode, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"
                              HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled"
                              ViewChanged="TimelineScrollViewer_ViewChanged" SizeChanged="TimelineViewport_SizeChanged">
                    <StackPanel Spacing="4">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.VideoTimelineFrames, Mode=OneWay}"
                                       ItemTemplate="{StaticResource TimelineMarkerTemplate}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.VideoTimelineFrames, Mode=OneWay}"
                                       ItemTemplate="{StaticResource TimelineThumbnailTemplate}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

                <!-- Classic: current-master center/snap interaction semantics, rehosted over real video frames only. -->
                <Grid x:Name="ClassicTimelineRoot" Grid.Row="1" Grid.RowSpan="2" Height="118"
                      Visibility="{x:Bind ViewModel.IsClassicPresentationMode, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                    <ScrollViewer x:Name="ClassicTimelineScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" ZoomMode="Disabled"
                                  ViewChanged="ClassicTimelineScrollViewer_ViewChanged"
                                  SizeChanged="ClassicTimelineScrollViewer_SizeChanged">
                        <Border x:Name="ClassicTimelinePaddingBorder" Padding="0">
                            <StackPanel Spacing="4">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.VideoTimelineFrames, Mode=OneWay}"
                                               ItemTemplate="{StaticResource TimelineMarkerTemplate}">
                                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.VideoTimelineFrames, Mode=OneWay}"
                                               ItemTemplate="{StaticResource TimelineThumbnailTemplate}">
                                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="6"/></ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    <Border Width="76" Height="76" CornerRadius="7" BorderThickness="3"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                </Grid>

                <!-- D. Overview Bar: same full width as the frame viewport, never a playback seek bar. -->
                <Border x:Name="TimelineOverviewTrack" Grid.Row="3" Height="16" CornerRadius="8"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        SizeChanged="TimelineOverviewTrack_SizeChanged">
                    <Canvas x:Name="TimelineOverviewCanvas" Height="16">
                        <Border x:Name="TimelineOverviewViewport" Height="10" CornerRadius="5"
                                Background="{ThemeResource ControlFillColorTertiaryBrush}" Canvas.Top="3"/>
                        <Border x:Name="TimelineOverviewPosition" Width="3" Height="12" CornerRadius="2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" Canvas.Top="2"/>
                    </Canvas>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
