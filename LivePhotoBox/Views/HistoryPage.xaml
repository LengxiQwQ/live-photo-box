<Page
    x:Class="LivePhotoBox.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LivePhotoBox.Models"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Color converters for timeline dots -->
        <Color x:Key="MergeColor">#4CAF50</Color>
        <Color x:Key="SplitColor">#2196F3</Color>
        <Color x:Key="RepairColor">#FF9800</Color>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- File card template -->
        <DataTemplate x:Key="FileCardTemplate" x:DataType="models:FileHistoryInfo">
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <StackPanel Spacing="0">
                    <!-- File header -->
                    <Grid ColumnSpacing="14" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- File icon -->
                        <Border Grid.Column="0"
                                Width="44" Height="44"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <FontIcon Glyph="&#xE8B9;" FontSize="20"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Border>

                        <!-- File name + metadata -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind FileName}"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Live Photo badge -->
                                <Border Visibility="{x:Bind IsLivePhoto, Converter={StaticResource VisibilityConverter}}"
                                        CornerRadius="4" Padding="8,2"
                                        Background="{ThemeResource SystemAccentColor}">
                                    <TextBlock Text="{x:Bind DetectedProtocol}"
                                               FontSize="11" Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <!-- LivePhotoBox badge -->
                                <Border Visibility="{x:Bind IsLivePhotoBoxGenerated, Converter={StaticResource VisibilityConverter}}"
                                        CornerRadius="4" Padding="8,2"
                                        Background="#4CAF50">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="White"/>
                                        <TextBlock Text="LivePhotoBox" FontSize="11"
                                                   Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Entry count -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind EntryCountText}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Entries separator -->
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                               Margin="0,0,0,12"
                               Visibility="{x:Bind HasEntries, Converter={StaticResource VisibilityConverter}}"/>

                    <!-- Timeline entries -->
                    <ItemsControl ItemsSource="{x:Bind Entries}"
                                  Visibility="{x:Bind HasEntries, Converter={StaticResource VisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HistoryEntry">
                                <Grid ColumnSpacing="12" Margin="0,0,0,4" Padding="8,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timeline dot -->
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderThickness="0">
                                        <FontIcon FontSize="14" FontWeight="SemiBold"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Glyph="{x:Bind ActionIcon}"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Border>

                                    <!-- Entry content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <!-- Action name + timestamp + version -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind ActionDisplayName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{x:Bind TimestampDisplay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Border CornerRadius="3" Padding="6,1"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0.5"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Version}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Text="{x:Bind Description}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind Description, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- No entries text -->
                    <TextBlock x:Uid="History_NoEntries"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind HasEntries, Converter={StaticResource InverseVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- ========== Main content ========== -->
        <Grid x:Name="ContentArea" Margin="40,24,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Folder picker -->
                <RowDefinition Height="Auto"/>  <!-- Status -->
                <RowDefinition Height="*"/>     <!-- Results / Empty -->
            </Grid.RowDefinitions>

            <!-- ── Page header ── -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7BA;" FontSize="22" Foreground="{ThemeResource SystemAccentColor}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="HistoryPage_Title"
                               FontSize="28" FontWeight="Bold"
                               FontFamily="Microsoft YaHei UI"/>
                </StackPanel>
                <TextBlock x:Uid="HistoryPage_Subtitle"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="32,0,0,0"
                           FontFamily="Microsoft YaHei UI"/>
            </StackPanel>

            <!-- ── Folder picker bar ── -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Select folder button -->
                    <Button Grid.Column="0"
                            x:Name="SelectFolderButton"
                            Click="SelectFolder_Click"
                            MinWidth="120">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE838;"/>
                            <TextBlock x:Uid="History_SelectFolder"/>
                        </StackPanel>
                    </Button>

                    <!-- Folder path display -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12,8" VerticalAlignment="Center">
                        <TextBlock x:Name="FolderPathText"
                                   x:Uid="History_NoFolderSelected"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Scan button -->
                    <Button Grid.Column="2"
                            x:Name="ScanButton"
                            Command="{x:Bind ViewModel.ScanFolderCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsScanning, Converter={StaticResource InverseBoolConverter}}"
                            MinWidth="100">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;"/>
                            <TextBlock x:Uid="History_ScanButton"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Status bar ── -->
            <Border Grid.Row="2" Margin="0,8,0,0"
                    Visibility="{x:Bind ViewModel.IsScanning, Converter={StaticResource VisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="200" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Summary bar (after scan) ── -->
            <Border Grid.Row="2" Margin="0,12,0,0"
                    Visibility="{x:Bind ViewModel.HasResults, Converter={StaticResource VisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B9;" FontSize="14"
                                  Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="{x:Bind ViewModel.SummaryStatsText, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Results list ── -->
            <ScrollViewer Grid.Row="3"
                          Margin="0,16,0,0"
                          Visibility="{x:Bind ViewModel.HasResults, Converter={StaticResource VisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                              ItemTemplate="{StaticResource FileCardTemplate}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── Empty state ── -->
            <Grid Grid.Row="3"
                  Visibility="{x:Bind ViewModel.HasResults, Converter={StaticResource InverseVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <!-- Elegant empty state icon -->
                    <Border Width="88" Height="88" CornerRadius="44"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B9;" FontSize="36"
                                  Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Uid="History_EmptyTitle"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="History_EmptyDesc"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
