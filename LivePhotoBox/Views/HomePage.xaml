<Page
    x:Class="LivePhotoBox.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d" Background="Transparent"
    NavigationCacheMode="Required">

    <!-- 首页/教程页：展示欢迎信息和实况照片合成、拆分、修复的图文教程 -->
    <Grid>
        <ScrollViewer x:Name="RootScrollViewer" Padding="40,24,40,0" HorizontalContentAlignment="Center">
            <Grid HorizontalAlignment="Stretch">
                <StackPanel Spacing="24" MaxWidth="1400" HorizontalAlignment="Stretch" Margin="0,0,0,40">

                <Grid x:Name="BannerRoot" Height="350" Margin="0,8,0,8" CornerRadius="12">
                    <Image 
                       x:Name="BannerImage"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       CacheMode="BitmapCache" />
                </Grid>

                <TextBlock x:Uid="HomePage_HeroSubtitle"
                       FontSize="16" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontFamily="Microsoft YaHei UI"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontWeight="Light"
                       Margin="0,0,0,8"/>

                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" 
                    Padding="32" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE916;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Uid="HomePage_WelcomeTitle" FontSize="20" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                        </StackPanel>
                        <TextBlock x:Uid="HomePage_Intro1" TextWrapping="Wrap" LineHeight="26" FontFamily="Microsoft YaHei UI" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Uid="HomePage_Intro2" TextWrapping="Wrap" LineHeight="26" FontFamily="Microsoft YaHei UI" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CoreFeaturesTitle" x:Uid="HomePage_CoreFeaturesTitle" FontSize="20" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI" Margin="0,16,0,-8"/>

                <!-- 实况照片合成教程 - 左图右字布局 -->
                <Border x:Name="MergeTutorialBorder" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" 
                    Padding="32" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="24">
                        <!-- 教程标题 + 按钮 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B1;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}"/>
                                <StackPanel>
                                    <TextBlock x:Uid="HomePage_MergeTitle" FontSize="20" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                                    <TextBlock x:Uid="HomePage_MergeSubtitle" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Microsoft YaHei UI" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Uid="HomePage_TryMergeDemo" x:Name="TryMergeDemoButton" Style="{ThemeResource AccentButtonStyle}" 
                                    Click="TryMergeDemo_Click" Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 步骤一：准备照片文件夹 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字 - 序号和文字同行 -->
                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="1" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_Tutorial_Step1_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_Tutorial_Step1_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 图片 - 固定宽高，图片自适应缩放 -->
                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage1" Source="ms-appx:///Assets/Tutorials/combo-01.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage1Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 步骤二：选择文件夹 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字 - 序号和文字同行 -->
                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="2" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_Tutorial_Step2_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_Tutorial_Step2_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 图片 - 固定宽高，图片自适应缩放 -->
                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage2" Source="ms-appx:///Assets/Tutorials/combo-02.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage2Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 步骤三：扫描并确认 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字 - 序号和文字同行 -->
                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="3" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_Tutorial_Step3_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_Tutorial_Step3_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 图片 - 固定宽高，图片自适应缩放 -->
                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage3" Source="ms-appx:///Assets/Tutorials/combo-03.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage3Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 步骤四：等待完成 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字 - 序号和文字同行 -->
                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="4" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_Tutorial_Step4_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_Tutorial_Step4_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 图片 - 固定宽高，图片自适应缩放 -->
                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage4" Source="ms-appx:///Assets/Tutorials/combo-04.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage4Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 教程结尾按钮 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,-8,0,8"
                                x:Name="MergeTutorialReadyDivider" />
                        <Grid x:Name="MergeTutorialReadySection">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Uid="HomePage_Tutorial_Ready_Title"
                                           FontSize="15" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Uid="HomePage_Tutorial_Ready_Subtitle"
                                           FontSize="13" FontFamily="Microsoft YaHei UI"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button x:Uid="HomePage_TryMergeDemo" x:Name="TutorialLoadSampleButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="TryMergeDemo_Click"
                                    Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 实况照片拆分教程 - 左图右字布局 -->
                <Border x:Name="SplitTutorialBorder" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" 
                    Padding="32" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="24">
                        <!-- 教程标题 + 按钮 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C6;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}"/>
                                <StackPanel>
                                    <TextBlock x:Uid="HomePage_SplitTitle" FontSize="20" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                                    <TextBlock x:Uid="HomePage_SplitSubtitle" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Microsoft YaHei UI" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Uid="HomePage_TrySplitDemo" x:Name="TrySplitDemoButton" Style="{ThemeResource AccentButtonStyle}" 
                                    Click="TrySplitDemo_Click" Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 步骤一：准备实况照片 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字 - 序号和文字同行 -->
                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="1" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_SplitTutorial_Step1_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_SplitTutorial_Step1_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 图片 - 固定宽高，图片自适应缩放 -->
                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage5" Source="ms-appx:///Assets/Tutorials/split-01.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage5Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 步骤二：选择文件夹并拆分 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字 - 序号和文字同行 -->
                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="2" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_SplitTutorial_Step2_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_SplitTutorial_Step2_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 图片 - 固定宽高，图片自适应缩放 -->
                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage6" Source="ms-appx:///Assets/Tutorials/split-02.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage6Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 步骤三：查看导出结果 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 文字 - 序号和文字同行 -->
                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="3" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_SplitTutorial_Step3_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_SplitTutorial_Step3_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- 图片 - 固定宽高，图片自适应缩放 -->
                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage7" Source="ms-appx:///Assets/Tutorials/split-03.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage7Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 教程结尾按钮 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,-8,0,8"
                                x:Name="SplitTutorialReadyDivider" />
                        <Grid x:Name="SplitTutorialReadySection">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Uid="HomePage_Tutorial_Ready_Title"
                                           FontSize="15" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Uid="HomePage_SplitTutorial_Ready_Subtitle"
                                           FontSize="13" FontFamily="Microsoft YaHei UI"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button x:Uid="HomePage_TrySplitDemo" x:Name="TutorialLoadSplitSampleButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="TrySplitDemo_Click"
                                    Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 实况照片显示修复教程 -->
                <Border x:Name="RepairTutorialBorder" CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                    Padding="32" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="24">
                        <!-- 教程标题 + 按钮 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7C5;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}"/>
                                <StackPanel>
                                    <TextBlock x:Uid="HomePage_RepairTitle" FontSize="20" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                                    <TextBlock x:Uid="HomePage_RepairSubtitle" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Microsoft YaHei UI" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Uid="HomePage_TryRepairDemo" x:Name="TryRepairDemoButton" Style="{ThemeResource AccentButtonStyle}"
                                    Click="TryRepairDemo_Click" Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 步骤一：它能修复什么？- 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="1" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_RepairTutorial_Step1_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_RepairTutorial_Step1_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage8" Source="ms-appx:///Assets/Tutorials/repair-01.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage8Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 步骤二：扫描并查看诊断 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="2" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_RepairTutorial_Step2_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_RepairTutorial_Step2_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage9" Source="ms-appx:///Assets/Tutorials/repair-02.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage9Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- 步骤三：选择输出模式并开始修复 - 左字右图 -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="Transparent" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="3" FontSize="16" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Uid="HomePage_RepairTutorial_Step3_Title"
                                                   FontSize="16" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Uid="HomePage_RepairTutorial_Step3_Desc"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Column="1" MinHeight="200" VerticalAlignment="Center">
                                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Padding="8"
                                        PointerEntered="TutorialImageBorder_PointerEntered"
                                        PointerExited="TutorialImageBorder_PointerExited">
                                    <Image x:Name="TutorialImage10" Source="ms-appx:///Assets/Tutorials/repair-03.png"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ImageOpened="TutorialImage_Opened" ImageFailed="TutorialImage_Failed"/>
                                </Border>
                                <Border x:Name="TutorialImage10Placeholder" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Uid="HomePage_Tutorial_ImagePlaceholder" Margin="0,8,0,0"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontFamily="Microsoft YaHei UI" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 安心提示 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Border Background="Transparent" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Top" Margin="0,3,12,0"/>
                                    <TextBlock Grid.Column="1" x:Uid="HomePage_RepairTutorial_Reassurance"
                                               TextWrapping="Wrap" LineHeight="22" FontFamily="Microsoft YaHei UI"
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Button x:Uid="HomePage_GoToSettingsStrictScan" Grid.Column="1"
                                        VerticalAlignment="Center" Margin="16,0,0,0"
                                        Click="GoToSettingsStrictScan_Click"/>
                            </Grid>
                        </Border>

                        <!-- 教程结尾按钮 -->
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,-8,0,8"
                                x:Name="RepairTutorialReadyDivider" />
                        <Grid x:Name="RepairTutorialReadySection">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Uid="HomePage_Tutorial_Ready_Title"
                                           FontSize="15" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Uid="HomePage_RepairTutorial_Ready_Subtitle"
                                           FontSize="13" FontFamily="Microsoft YaHei UI"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button x:Uid="HomePage_TryRepairDemo" x:Name="TutorialLoadRepairSampleButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="TryRepairDemo_Click"
                                    Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 主图切换 -->
                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" 
                    Padding="24" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE895;" FontSize="32" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Top" Margin="0,2,20,0"/>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock x:Uid="HomePage_KeyPhotoTitle" FontSize="18" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                                <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Uid="HomePage_WIPLabel" FontSize="12" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="HomePage_FeatureIntroLabel" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top"/>
                                <TextBlock x:Uid="HomePage_KeyPhotoDesc" Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap" LineHeight="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="HomePage_HowToUseLabel" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top"/>
                                <TextBlock x:Uid="HomePage_KeyPhotoUsage" Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap" LineHeight="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 使用提示 -->
                <Border CornerRadius="12" Background="{ThemeResource CardBackgroundBrush}" 
                    Padding="24" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="HomePage_TipLabel" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top"/>
                        <TextBlock x:Uid="HomePage_TipText"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Top"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>

            </StackPanel>
            </Grid>
        </ScrollViewer>

        <Button x:Name="FloatingGuideButton"
                Width="34" Height="34"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,41,40"
                Click="FloatingGuideButton_Click">
            <ToolTipService.ToolTip>
                <TextBlock x:Uid="HomePage_GuideButton_Tooltip" />
            </ToolTipService.ToolTip>
            <Border CornerRadius="10" Background="Transparent" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <FontIcon Glyph="&#xE897;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Button>
        <Canvas x:Name="HoverOverlay" IsHitTestVisible="False" Visibility="Collapsed"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border x:Name="HoverImageBorder" Background="Transparent" CornerRadius="8" BorderThickness="1"
                    BorderBrush="#40000000">
                <Image x:Name="HoverImage" Stretch="Uniform" IsHitTestVisible="False"/>
            </Border>
        </Canvas>
    </Grid>
</Page>
