<Page
    x:Class="LivePhotoBox.Views.SettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d" Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="PageScrollViewer" Padding="40,24,40,0">

        <StackPanel x:Name="ContentPanel" Spacing="28" HorizontalAlignment="Stretch" Margin="0,0,0,40">

            <!-- ==================== 页面标题 ==================== -->
            <TextBlock x:Uid="SettingsPage_Title" FontSize="32" FontWeight="Bold" Margin="0,0,0,8" FontFamily="Microsoft YaHei UI"/>

            <!-- ====================================================================== -->
            <!--  外观与个性化                                                         -->
            <!-- ====================================================================== -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                    <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="SettingsPage_Appearance_Header" FontSize="18" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Language" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Language_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" FontSize="16"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}"
                              Loaded="AppearanceComboBox_Loaded"
                              MinWidth="200">
                        <ComboBoxItem x:Uid="SettingsPage_Language_System"/>
                        <ComboBoxItem Content="English (en-US)"/>
                        <ComboBoxItem Content="中文(简体) (zh-Hans)"/>
                        <ComboBoxItem Content="中文(繁體) (zh-Hant)"/>
                        <ComboBoxItem Content="日本語 (ja) — 開発中"/>
                        <ComboBoxItem Content="한국어 (ko) — 개발 중"/>
                        <ComboBoxItem Content="Français (fr) — En développement"/>
                        <ComboBoxItem Content="Deutsch (de) — In Entwicklung"/>
                        <ComboBoxItem Content="Español (es) — En desarrollo"/>
                        <ComboBoxItem Content="Русский (ru) — В разработке"/>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
    <controls:SettingsCard.Header>
        <TextBlock x:Uid="SettingsPage_Theme_Header" FontFamily="Microsoft YaHei UI"/>
    </controls:SettingsCard.Header>
    <controls:SettingsCard.Description>
        <TextBlock x:Uid="SettingsPage_Theme_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    </controls:SettingsCard.Description>
    <controls:SettingsCard.HeaderIcon>
        <FontIcon Glyph="&#xE790;" FontSize="16"/>
    </controls:SettingsCard.HeaderIcon>
    <ComboBox SelectedIndex="{x:Bind ViewModel.ElementTheme, Mode=TwoWay}"
              Loaded="AppearanceComboBox_Loaded"
              MinWidth="200">
        <ComboBoxItem x:Uid="SettingsPage_Theme_System"/>
        <ComboBoxItem x:Uid="SettingsPage_Theme_Light"/>
        <ComboBoxItem x:Uid="SettingsPage_Theme_Dark"/>
    </ComboBox>
</controls:SettingsCard>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Backdrop_Header" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Backdrop_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEB91;" FontSize="16"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}"
                              Loaded="AppearanceComboBox_Loaded"
                              MinWidth="200">
                        <ComboBoxItem x:Uid="SettingsPage_Backdrop_Mica"/>
                        <ComboBoxItem x:Uid="SettingsPage_Backdrop_MicaAlt"/>
                        <ComboBoxItem x:Uid="SettingsPage_Backdrop_Acrylic"/>
                        <ComboBoxItem x:Uid="SettingsPage_Backdrop_AcrylicLight"/>
                        <ComboBoxItem x:Uid="SettingsPage_Backdrop_None"/>
                    </ComboBox>
                </controls:SettingsCard>

                <!-- Acrylic 浓度滑块（仅选 Acrylic / Acrylic 薄透 时可见） -->
                <controls:SettingsCard FontFamily="Microsoft YaHei UI"
                                       Visibility="{x:Bind ViewModel.BackdropIndex, Mode=OneWay, Converter={StaticResource BackdropToAcrylicVisibilityConverter}}">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_AcrylicOpacity_Header" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_AcrylicOpacity_Desc" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <ic:SymbolIcon Symbol="SquareHintSparkles" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Slider Minimum="0.0" Maximum="1.0"
                                Value="{x:Bind ViewModel.AcrylicTintOpacity, Mode=TwoWay}"
                                StepFrequency="0.05" Width="220" VerticalAlignment="Center"
                                ThumbToolTipValueConverter="{StaticResource DoubleToPercentConverter}"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4"
                                MinWidth="44" Height="36"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="8,0" FontSize="13" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel.AcrylicTintOpacityText, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- 窗口整体透明度 -->
                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_WindowOpacity_Header" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_WindowOpacity_Desc" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF5EF;" FontSize="16"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Slider Minimum="0.1" Maximum="1.0"
                                Value="{x:Bind ViewModel.WindowOpacity, Mode=TwoWay}"
                                StepFrequency="0.01" Width="220" VerticalAlignment="Center"
                                ThumbToolTipValueConverter="{StaticResource DoubleToPercentConverter}"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4"
                                MinWidth="44" Height="36"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="8,0" FontSize="13" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel.WindowOpacityText, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- 主页背景（可折叠） -->
                <controls:SettingsExpander FontFamily="Microsoft YaHei UI">
                    <controls:SettingsExpander.Header>
                        <TextBlock x:Uid="SettingsPage_Banner_Header" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.Description>
                        <TextBlock x:Uid="SettingsPage_Banner_Desc" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsExpander.Description>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9A6;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <!-- 折叠内容：左预览图 + 右当前预设名称 -->
                        <!-- ContentAlignment="Vertical" → 内容独占全宽，不走默认的左右分栏 -->
                        <controls:SettingsCard ContentAlignment="Vertical"
                                               HorizontalContentAlignment="Stretch">
                            <controls:SettingsCard.Resources>
                                <x:Double x:Key="SettingsCardLeftIndention">0</x:Double>
                            </controls:SettingsCard.Resources>
                            <Grid Margin="0,8,0,8" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：320×135 预览 + 切换箭头 -->
                                <Border Grid.Column="0" CornerRadius="8" Width="320" Height="135">
                                    <Grid>
                                        <Image Source="{x:Bind ViewModel.BannerImage0, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.Banner0Visible, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               VerticalAlignment="Stretch"
                                               HorizontalAlignment="Center"/>
                                        <Image Source="{x:Bind ViewModel.BannerImage1, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.Banner1Visible, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               VerticalAlignment="Stretch"
                                               HorizontalAlignment="Center"/>
                                        <Image Source="{x:Bind ViewModel.BannerImage2, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.Banner2Visible, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               VerticalAlignment="Stretch"
                                               HorizontalAlignment="Center"/>
                                        <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Click="PrevBanner_Click"
                                                Background="#33000000" BorderThickness="0"
                                                Width="32" Height="48" Padding="0"
                                                CornerRadius="0,4,4,0">
                                            <FontIcon Glyph="&#xE76B;" FontSize="14" Foreground="White"/>
                                        </Button>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="NextBanner_Click"
                                                Background="#33000000" BorderThickness="0"
                                                Width="32" Height="48" Padding="0"
                                                CornerRadius="4,0,0,4">
                                            <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="White"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 右侧：当前预设名称 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock x:Uid="SettingsPage_Banner_CurrentLabel" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentBannerPresetName, Mode=OneWay}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </controls:SettingsCard>

                        <!-- 随机切换开关 -->
                        <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                            <controls:SettingsCard.Header>
                                <TextBlock x:Uid="SettingsPage_BannerRandom_Header" FontFamily="Microsoft YaHei UI"/>
                            </controls:SettingsCard.Header>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Uid="SettingsPage_BannerRandom_Desc" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </controls:SettingsCard.Description>
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8AE;" FontSize="16"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsBannerRandomEnabled, Mode=TwoWay}"
                                          x:Uid="Toggle_OnOff"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <!-- ====================================================================== -->
            <!--  视频转码                                                             -->
            <!-- ====================================================================== -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                    <FontIcon Glyph="&#xEA69;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="SettingsPage_Transcode_Header" FontSize="18" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Transcode_Hardware" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Transcode_Hardware_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEEA1;" FontSize="16"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:Name="HardwareComboBox"
                                  ItemsSource="{x:Bind ViewModel.AvailableHardware, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedHardware, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Loaded="HardwareComboBox_Loaded"
                                  MinWidth="200"/>
                        <Button Width="32" Height="32" Padding="0"
                                x:Uid="SettingsPage_HardwareRefresh_Button"
                                Command="{x:Bind ViewModel.RefreshHardwareCommand, Mode=OneWay}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Transcode_ThreadCount" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Transcode_ThreadCount_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <ic:SymbolIcon Symbol="FastForward" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Slider Minimum="1"
                                Maximum="{x:Bind ViewModel.MaxThreadCount, Mode=OneWay}"
                                Value="{x:Bind ViewModel.ThreadCount, Mode=TwoWay}"
                                StepFrequency="1"
                                Width="220"
                                VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4"
                                MinWidth="36" Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ThreadCount, Mode=OneWay}"
                                       TextAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="8,0"/>
                        </Border>
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <!-- ====================================================================== -->
            <!--  实况照片合成                                                         -->
            <!-- ====================================================================== -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                    <FontIcon Glyph="&#xE8B1;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="SettingsPage_Combo_Header" FontSize="18" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Combo_HeicDecoder" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="SettingsPage_Combo_HeicDecoder_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <HyperlinkButton x:Uid="SettingsPage_Combo_HeicDecoder_HeifLink"
                                                 FontSize="12"
                                                 Padding="0"
                                                 Click="OpenHeifStoreLink_Click"/>
                                <HyperlinkButton x:Uid="SettingsPage_Combo_HeicDecoder_HevcLink"
                                                 FontSize="12"
                                                 Padding="0"
                                                 Click="OpenHevcStoreLink_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <ic:SymbolIcon Symbol="DeveloperBoardSearch" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.HeicDecoderIndex, Mode=TwoWay}"
                              Loaded="AppearanceComboBox_Loaded"
                              MinWidth="200">
                        <ComboBoxItem x:Uid="SettingsPage_Combo_HeicDecoder_MagickNET"/>
                        <ComboBoxItem x:Uid="SettingsPage_Combo_HeicDecoder_BitmapDecoder"/>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Combo_ThreadCount" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Combo_ThreadCount_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <ic:SymbolIcon Symbol="FastForward" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Slider Minimum="1"
                                Maximum="{x:Bind ViewModel.MaxComboThreadCount, Mode=OneWay}"
                                Value="{x:Bind ViewModel.ComboThreadCount, Mode=TwoWay}"
                                StepFrequency="1"
                                Width="220"
                                VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4"
                                MinWidth="36" Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ComboThreadCount, Mode=OneWay}"
                                       TextAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="8,0"/>
                        </Border>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Combo_GoogleForceMp4" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Combo_GoogleForceMp4_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <ic:SymbolIcon Symbol="VideoSync" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsGoogleProtocolForceMp4, Mode=TwoWay}"
                                  x:Uid="Toggle_OnOff"/>
                </controls:SettingsCard>
            </StackPanel>

            <!-- ====================================================================== -->
            <!--  实况照片拆分                                                         -->
            <!-- ====================================================================== -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                    <FontIcon Glyph="&#xE8C6;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="SettingsPage_Split_Header" FontSize="18" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Split_FormatLabel" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Split_FormatDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE714;" FontSize="16"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SplitFormatIndex, Mode=TwoWay}"
                              Loaded="AppearanceComboBox_Loaded"
                              MinWidth="200">
                        <ComboBoxItem x:Uid="SettingsPage_SplitFormat_ImageDefault"/>
                        <ComboBoxItem x:Uid="SettingsPage_SplitFormat_MP4"/>
                        <ComboBoxItem x:Uid="SettingsPage_SplitFormat_MOV"/>
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>

            <!-- ====================================================================== -->
            <!--  实况照片显示修复                                                           -->
            <!-- ====================================================================== -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                    <FontIcon Glyph="&#xE7C5;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock x:Uid="SettingsPage_Repair_Header" FontSize="18" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Repair_HeicLabel" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Repair_HeicDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <ic:SymbolIcon Symbol="ScanCamera" FontSize="16"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsHeicRepairEnabled, Mode=TwoWay}"
                                  x:Uid="Toggle_OnOff"/>
                </controls:SettingsCard>

                <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingsPage_Repair_LivePhotoVideoLabel" FontFamily="Microsoft YaHei UI"/>
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="SettingsPage_Repair_LivePhotoVideoDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <ic:SymbolIcon Symbol="VideoSettings" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsNonLivePhotoVideoRepairEnabled, Mode=TwoWay}"
                                  x:Uid="Toggle_OnOff"/>
                </controls:SettingsCard>
            </StackPanel>

            <!-- ====================================================================== -->
            <!--  调试工具区                                                           -->
            <!-- ====================================================================== -->
            <StackPanel Margin="0,0,0,0" Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            HorizontalAlignment="Left"
                            Click="ToggleTestToolsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEC7A;" FontSize="14"/>
                            <TextBlock Text="{x:Bind TestToolsToggleButtonText, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Click="RestoreDefaultSettings_Click"
                            HorizontalAlignment="Right"
                            BorderThickness="0"
                            Style="{ThemeResource DefaultButtonStyle}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#D32F2F"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EF5350"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C62828"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="White"/>
                            <TextBlock x:Uid="SettingsPage_Restore_Button_Text" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="{x:Bind CrashNoticeText, Mode=OneTime}"
                           Visibility="{x:Bind CrashNoticeVisibility, Mode=OneWay}"
                           Foreground="{ThemeResource SystemErrorTextColor}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,16"/>

                <StackPanel Spacing="20"
                            Visibility="{x:Bind TestToolsVisibility, Mode=OneWay}">

                    <!-- 应用日志 -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Uid="SettingsPage_Crash_Header" FontSize="18" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                        </StackPanel>

                        <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SettingsPage_CrashLastTime_Label" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <HyperlinkButton Command="{x:Bind AboutViewModel.OpenLatestCrashLogActionCommand, Mode=OneWay}" Padding="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind AboutViewModel.LastCrashFileNameText, Mode=OneWay}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                    <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                        <Button Command="{x:Bind AboutViewModel.OpenCrashLogFolderActionCommand, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE838;" FontSize="14"/>
                                                <TextBlock x:Uid="SettingsPage_CrashOpenFolder_Button_Text" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind AboutViewModel.ExportLatestCrashLogActionCommand, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                                                <TextBlock x:Uid="SettingsPage_CrashExportLatest_Button_Text" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind AboutViewModel.ClearCrashLogsActionCommand, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                <TextBlock x:Uid="SettingsPage_CrashClear_Button_Text" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind AboutViewModel.OpenIssueFeedbackActionCommand, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                                <TextBlock x:Uid="SettingsPage_CrashIssue_Button_Text" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </toolkit:WrapPanel>

                                    <TextBlock x:Uid="SettingsPage_CrashLogPrivacyHint"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                    </StackPanel>

                    <!-- 调试工具 — 全部统一使用 SettingsCard -->


                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                            <FontIcon Glyph="&#xEBE8;" FontSize="18" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Uid="SettingsPage_Test_Header" FontSize="18" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                        </StackPanel>

                        <TextBlock x:Uid="SettingsPage_Test_Warning"
                                   FontSize="12"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>



                        <!-- 操作按钮 -->
                        <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xEC7A;" FontSize="16"/>
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Click="RestartAppButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                            <TextBlock x:Uid="SettingsPage_RestartApp_Button_Text" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="PreviewCrashDialogButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A1;" FontSize="14"/>
                                            <TextBlock x:Uid="SettingsPage_CrashPreviewDialog_Button_Text" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="SwitchToClassic_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8AB;" FontSize="14"/>
                                            <TextBlock x:Uid="SettingsPageModern_SwitchToClassic_Button_Text" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </toolkit:WrapPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>

                        <!-- 扫描缩略图开关 -->
                        <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                            <controls:SettingsCard.Header>
                                <TextBlock x:Uid="SettingsPage_ScanThumbnailToggleLabel" FontFamily="Microsoft YaHei UI"/>
                            </controls:SettingsCard.Header>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Uid="SettingsPage_ScanThumbnailToggleDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </controls:SettingsCard.Description>
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7C5;" FontSize="16"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsRepairScanLoadThumbnail, Mode=TwoWay}"
                                          x:Uid="Toggle_EnabledDisabled">
                                <ToggleSwitch.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#D32F2F"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#EF5350"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#C62828"/>
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </controls:SettingsCard>

                        <!-- 严格实况照片扫描开关 -->
                        <controls:SettingsCard FontFamily="Microsoft YaHei UI">
                            <controls:SettingsCard.Header>
                                <TextBlock x:Uid="SettingsPage_StrictLivePhotoScanLabel" FontFamily="Microsoft YaHei UI"/>
                            </controls:SettingsCard.Header>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Uid="SettingsPage_StrictLivePhotoScanDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </controls:SettingsCard.Description>
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE721;" FontSize="16"/>
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsStrictLivePhotoScanEnabled, Mode=TwoWay}"
                                          x:Uid="Toggle_EnabledDisabled">
                                <ToggleSwitch.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#D32F2F"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#EF5350"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#C62828"/>
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </controls:SettingsCard>

                    </StackPanel>
                </StackPanel>

                <TextBlock x:Uid="SettingsPage_Footer"
                           FontSize="12" Opacity="0.3"
                           HorizontalAlignment="Center"
                           Margin="0,38,0,20"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
